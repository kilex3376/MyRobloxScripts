local pulseConn = nil
local function startPulse()
    local t = 0
    pulseConn = RunService.Heartbeat:Connect(function(dt)
        t += dt
        local a = (math.sin(t*4)+1)/2
        recordStroke.Color = Color3.fromRGB(239,math.floor(68*a),math.floor(68*a))
    end)
end
local function stopPulse()
    if pulseConn then pulseConn:Disconnect() pulseConn=nil end
    recordStroke.Color = Color3.fromRGB(239,68,68)
end

local function safeInvoke(remote, maxRetries, ...)
    local args = {...}
    for attempt = 1, maxRetries do
        local ok, result = pcall(function()
            return remote:InvokeServer(table.unpack(args))
        end)
        if ok then return true, result end
        task.wait(0.15 * attempt)
    end
    return false, nil
end

local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    local args   = {...}
    local method = getnamecallmethod()
    if not checkcaller() and recording then
        local name = tostring(self)
        if name == "SpawnNewTower" and method == "InvokeServer" then
            local ok, result = pcall(old, self, ...)
            if not ok then return end
            local cf = args[2]
            if typeof(cf) ~= "CFrame" then return result end
            local idx = #placed + 1
            placed[idx] = result
            table.insert(slots[currentSlot].steps, {
                action    = "spawn",
                towerIndex = idx,
                unitUUID  = tostring(args[1]),
                time      = tick() - startTime,
                pos       = { x=cf.X, y=cf.Y, z=cf.Z }
            })
            updateCounter()
            log("Spawn #"..idx, Color3.fromRGB(34,197,94))
            return result
        end
        if name == "UpgradeTower" and method == "InvokeServer" then
            local tower = args[1]
            for i,v in pairs(placed) do
                if v == tower then
                    table.insert(slots[currentSlot].steps, {
                        action     = "upgrade",
                        towerIndex = i,
                        time       = tick() - startTime
                    })
                    updateCounter()
                    log("Upgrade #"..i, Color3.fromRGB(234,179,8))
                    break
                end
            end
        end
    end
    return old(self, ...)
end)

