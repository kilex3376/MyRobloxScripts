task.defer(function()
    local ok, funcs = pcall(function() return ReplicatedStorage:WaitForChild("Functions") end)
    if not ok or not funcs then return end
    SpawnTower   = funcs:FindFirstChild("SpawnNewTower") or funcs:WaitForChild("SpawnNewTower")
    UpgradeTower = funcs:FindFirstChild("UpgradeTower")  or funcs:WaitForChild("UpgradeTower")
    if statusLabel then
        statusLabel.Text       = "Ready"
        statusLabel.TextColor3 = Color3.fromRGB(34, 197, 94)
    end
end)

local SLOT_COUNT  = 3
local slots       = {}
local currentSlot = 1

for i = 1, SLOT_COUNT do
    slots[i] = { name = "Macro " .. i, steps = {} }
    if isfile and isfile("macro_slot"..i..".json") then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile("macro_slot"..i..".json"))
        end)
        if ok and data then
            slots[i].name  = data.name  or ("Macro " .. i)
            slots[i].steps = data.steps or {}
        end
    end
end

local recording     = false
local playing       = false
local startTime     = 0
local placed        = {}
local playbackSpeed = 1.0
local statusLabel   = nil

local function log(msg, color)
    if statusLabel then
        statusLabel.Text       = msg
        statusLabel.TextColor3 = color or Color3.fromRGB(200, 200, 255)
    end
    print("[Macro] " .. msg)
end

local function tw(obj, props, dur)
    TweenService:Create(obj, TweenInfo.new(dur or 0.15, Enum.EasingStyle.Quad), props):Play()
end

local function saveSlot(i)
    if not writefile then return end
    pcall(function()
        writefile("macro_slot"..i..".json", HttpService:JSONEncode({
            name  = slots[i].name,
            steps = slots[i].steps
        }))
    end)
end

