loadBtn.MouseButton1Click:Connect(function()
    local file = "macro_slot"..currentSlot..".json"
    if not isfile(file) then
        log("No save for slot "..currentSlot, Color3.fromRGB(239,68,68)) return
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
    if ok and data then
        slots[currentSlot].name  = data.name  or ("Macro "..currentSlot)
        slots[currentSlot].steps = data.steps or {}
        refreshSlotBtns()
        updateCounter()
        log("Loaded "..#slots[currentSlot].steps.." steps", Color3.fromRGB(59,130,246))
    else
        log("Load failed!", Color3.fromRGB(239,68,68))
    end
end)

playBtn.MouseButton1Click:Connect(function()
    if playing   then log("Already playing!",      Color3.fromRGB(239,68,68)) return end
    if recording then log("Stop recording first!", Color3.fromRGB(239,68,68)) return end
    local steps = slots[currentSlot].steps
    if #steps == 0 then
        log("Slot "..currentSlot.." is empty!", Color3.fromRGB(239,68,68)) return
    end
    if not SpawnTower or not UpgradeTower then
        log("Remotes not ready!", Color3.fromRGB(239,68,68)) return
    end
    playing = true
    tw(playBtn,{BackgroundColor3=Color3.fromRGB(40,40,80)})
    playStroke.Color = Color3.fromRGB(99,102,241)
    task.spawn(function()
        local created   = {}
        local errors    = 0
        local playStart = os.clock()
        for i, step in ipairs(steps) do
            if not playing then break end
            local target = playStart + (step.time / playbackSpeed)
            local rough  = target - os.clock() - 0.05
            if rough > 0 then task.wait(rough) end
            while os.clock() < target do RunService.Heartbeat:Wait() end
            log(string.format("[%d/%d] %s", i, #steps, step.action), Color3.fromRGB(99,102,241))
            if step.action == "spawn" then
                local ok, result = safeInvoke(SpawnTower, 3,
                    step.unitUUID,
                    CFrame.new(step.pos.x, step.pos.y, step.pos.z))
                if ok then
                    created[step.towerIndex] = result
                else
                    errors += 1
                    warn("[Macro] Spawn failed step "..i)
                end
            elseif step.action == "upgrade" then
                local tower = created[step.towerIndex]
                if tower then
                    local ok2 = safeInvoke(UpgradeTower, 5, tower)
                    if not ok2 then
                        errors += 1
                        warn("[Macro] Upgrade failed step "..i)
                    end else if step.action == "upgrade" then
                local tower = created[step.towerIndex]
                if tower then
                    local ok2 = safeInvoke(UpgradeTower, 5, tower)
                    if not ok2 then
                        errors += 1
                        warn("[Macro] Upgrade failed step "..i)
                    end             else
                    errors += 1
                    warn("[Macro] Tower missing at step "..i)
                end
            end
        end
        playing = false
        tw(playBtn,{BackgroundColor3=Color3.fromRGB(32,32,48)})
        playStroke.Color = Color3.fromRGB(60,60,90)
        log(errors > 0
            and string.format("Done - %d error(s)", errors)
            or  "Playback complete!",
            errors > 0 and Color3.fromRGB(234,179,8) or Color3.fromRGB(34,197,94))
    end)
end)
