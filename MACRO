        tw(btn, {BackgroundColor3 = isActive and Color3.fromRGB(40,40,70) or Color3.fromRGB(26,26,38)})
        btn.UIStroke.Thickness   = isActive and 1.5 or 1
        btn.UIStroke.Color       = isActive and getSlotColor(i) or Color3.fromRGB(45,45,65)
        slotLabels[i].Text       = slots[i].name .. "  (" .. #slots[i].steps .. ")"
        slotLabels[i].TextColor3 = isActive and Color3.fromRGB(220,220,255) or Color3.fromRGB(120,120,160)
    end
end

