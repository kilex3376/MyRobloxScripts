local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TeleportService = game:GetService("TeleportService")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipWave, AutoSkip

-- ПОИСК REMOTES (из твоего рабочего кода)
task.spawn(function()
    for _,v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SpawnNewTower" or v.Name == "PlaceTower" then
            SpawnTower = v
        elseif v.Name == "UpgradeTower" then
            UpgradeTower = v
        elseif v.Name == "SkipWave" or v.Name == "VoteSkip" or v.Name == "Skip" then
            SkipWave = v
        elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then
            AutoSkip = v
        end
    end
end)

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

-- Переменные для защиты спавна (из твоего кода)
local lastSpawnTime = 0
local lastSpawnPos

local SETTINGS_FILE = "macro_settings_v14.json"

local function saveSettings()
    if writefile then writefile(SETTINGS_FILE, HttpService:JSONEncode({autoReplay = autoReplay, autoPlay = autoPlay, slot = currentSlot})) end
end

local function loadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then autoReplay = data.autoReplay or false autoPlay = data.autoPlay or false currentSlot = data.slot or 1 end
    end
end

local function forceClick(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 1)
    end)
end

--================ НАШЕ GUI ================--
