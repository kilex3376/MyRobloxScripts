-- // СТРОГИЙ ХУК ЗАПИСИ
local oldNC; oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    if recording and not checkcaller() then
        local t = os.clock() - startTime
        -- Фильтруем: только если это Remote и аргументы похожи на TD-действия
        if self:IsA("RemoteFunction") or self:IsA("RemoteEvent") then
            -- Записываем только если это НЕ движение и НЕ чат
            if self.Name ~= "SayMessageRequest" and not self.Name:find("Move") then
                table.insert(allMacros[currentSlot], {
                    action = "remote_call",
                    name = self.Name,
                    path = self:GetFullName(),
                    args = args,
                    t = t
                })
                task.spawn(updateUI)
            end
        end
    end
    return oldNC(self, ...)
end)

-- // ПЛЕЕР
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local start = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock() - start) < step.t do task.wait() end
            
            pcall(function()
                local remote = game:GetService("RunService"):FindFirstChild(step.name, true) or game:FindFirstChild(step.name, true)
                if remote then
                    if remote:IsA("RemoteFunction") then remote:InvokeServer(unpack(step.args))
                    else remote:FireServer(unpack(step.args)) end
                end
            end)
        end
        playing = false
        status.Text = "DONE"
    end)
end

-- // ЛОГИКА КНОПКИ REPLAY
task.spawn(function()
    while true do
        task.wait(1)
        if recording then
            for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") and v.Visible and (v.Text:lower():find("again") or v.Name:lower():find("Retry")) then
                    local conn; conn = v.MouseButton1Click:Connect(function()
                        if recording then
                            table.insert(allMacros[currentSlot], {action="replay_click", t=os.clock()-startTime})
                            recording = false
                            saveAll()
                            updateUI()
                        end
                        conn:Disconnect()
                    end)
                    repeat task.wait(1) until not v.Visible or not recording
                end
            end
        end
    end
end)

