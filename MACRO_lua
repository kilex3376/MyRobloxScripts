local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

if not game:IsLoaded() then game.Loaded:Wait() end
local lp = Players.LocalPlayer or Players.PlayerAdded:Wait()

local SpawnTower, UpgradeTower
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false

local SETTINGS_FILE = "macro_settings.json"

-- ПОИСК ИВЕНТОВ
task.spawn(function()
    while not SpawnTower do
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" then SpawnTower = v
            elseif v.Name == "UpgradeTower" then UpgradeTower = v end
        end
        task.wait(0.5)
    end
end)

-- ПОИСК ЮНИТА ПО ПОЗИЦИИ (Чтобы продажа работала после перезахода)
local function getUnitAtPos(pos)
    local closest, dist = nil, 2.5
    local folder = workspace:FindFirstChild("Towers") or workspace:FindFirstChild("Units") or workspace
    for _, u in ipairs(folder:GetDescendants()) do
        if u:IsA("Model") and u ~= lp.Character then
            local p = u.PrimaryPart or u:FindFirstChild("HumanoidRootPart") or u:FindFirstChildWhichIsA("BasePart")
            if p then
                local d = (p.Position - Vector3.new(pos[1], pos[2], pos[3])).Magnitude
                if d < dist then dist = d; closest = u end
            end
        end
    end
    return closest
end

-- СОХРАНЕНИЕ/ЗАГРУЗКА
local function saveAll(slot)
    if writefile then
        writefile("macro_s"..slot..".json", HttpService:JSONEncode(allMacros[slot]))
        writefile(SETTINGS_FILE, HttpService:JSONEncode({autoReplay = autoReplay, autoPlay = autoPlay, lastSlot = currentSlot}))
    end
end

local function loadAll()
    if readfile then
        for i = 1, 3 do
            if isfile("macro_s"..i..".json") then
                allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json"))
            end
        end
        if isfile(SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(SETTINGS_FILE))
            autoReplay, autoPlay, currentSlot = data.autoReplay or false, data.autoPlay or false, data.lastSlot or 1
        end
    end
end

-- ИНТЕРФЕЙС
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_Final"
ui.ResetOnSpawn = false

local main = Instance.new("Frame", ui)
main.Size = UDim2.new(0, 160, 0, 200)
main.Position = UDim2.new(0, 50, 0.5, -100)
main.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
main.Active, main.Draggable = true, true
Instance.new("UICorner", main)

local status = Instance.new("TextLabel", main)
status.Size = UDim2.new(1, 0, 0, 20)
status.Position = UDim2.new(0, 0, 1, -20)
status.Text, status.TextColor3, status.BackgroundTransparency = "READY", Color3.new(1,1,1), 1

local function createBtn(txt, pos, color)
    local b = Instance.new("TextButton", main)
    b.Size = UDim2.new(1, -14, 0, 30)
    b.Position = pos
    b.Text = txt
    b.BackgroundColor3 = color or Color3.fromRGB(50, 50, 50)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.SourceSansBold
    Instance.new("UICorner", b)
    return b
end

-- ЛОГИКА PLAY
local function startPlay()
    local macro = allMacros[currentSlot]
    if playing or #macro == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local begin = os.clock()
        for _, step in ipairs(macro) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    SpawnTower:InvokeServer(step.id, CFrame.new(unpack(step.cf)))
                elseif step.action == "upgrade" then
                    local unit = getUnitAtPos(step.pos)
                    if unit then UpgradeTower:InvokeServer(unit, step.type) end
                end
            end)
        end
        playing, status.Text = false, "FINISHED"
    end)
end

-- КНОПКИ
local recBtn = createBtn("RECORD", UDim2.new(0, 7, 0, 40), Color3.fromRGB(100, 30, 30))
local stopBtn = createBtn("STOP", UDim2.new(0, 7, 0, 75))
local playBtn = createBtn("PLAY", UDim2.new(0, 7, 0, 110), Color3.fromRGB(40, 60, 120))
local slotBtn = createBtn("SLOT: " .. currentSlot, UDim2.new(0, 7, 0, 145))

-- СОБЫТИЯ КНОПОК
slotBtn.MouseButton1Click:Connect(function()
    if not recording and not playing then
        currentSlot = currentSlot % 3 + 1
        slotBtn.Text = "SLOT: " .. currentSlot
        status.Text = "SWITCHED TO SLOT " .. currentSlot
    end
end)

recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    allMacros[currentSlot] = {}
    startTime, recording = os.clock(), true
    status.Text = "RECORDING..."
    
    local old; old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if recording and method == "InvokeServer" then
            if self == SpawnTower then
                table.insert(allMacros[currentSlot], {action = "spawn", id = args[1], cf = {args[2].X, args[2].Y, args[2].Z}, t = os.clock() - startTime})
            elseif self == UpgradeTower then
                local p = args[1].PrimaryPart or args[1]:FindFirstChild("HumanoidRootPart") or args[1]:FindFirstChildWhichIsA("BasePart")
                if p then
                    table.insert(allMacros[currentSlot], {action = "upgrade", pos = {p.Position.X, p.Position.Y, p.Position.Z}, type = args[2], t = os.clock() - startTime})
                end
            end
        end
        return old(self, ...)
    end)
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    status.Text = "SAVED"
    saveAll(currentSlot)
end)

playBtn.MouseButton1Click:Connect(startPlay)

loadAll()
slotBtn.Text = "SLOT: " .. currentSlot
