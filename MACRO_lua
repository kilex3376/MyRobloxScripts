-- СИСТЕМА ФАЙЛОВ
local function saveSettings()
    if writefile then
        pcall(function()
            writefile(SETTINGS_FILE, HttpService:JSONEncode({
                autoReplay = autoReplay,
                autoPlay = autoPlay,
                lastSlot = currentSlot
            }))
        end)
    end
end

local function loadSettings()
    if readfile and isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then
            autoReplay = data.autoReplay or false
            autoPlay = data.autoPlay or false
            currentSlot = data.lastSlot or 1
        end
    end
end

local function setReplayFlag(slot)
    if writefile then pcall(function() writefile(FLAG_FILE, HttpService:JSONEncode({slot = slot})) end) end
end

local function getReplayFlag()
    if not readfile or not isfile or not isfile(FLAG_FILE) then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FLAG_FILE)) end)
    return (ok and data and data.slot) or nil
end

