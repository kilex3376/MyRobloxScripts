    slotBtn.Text = "SLOT: "..currentSlot.." ("..#allMacros[currentSlot]..")"
    arBtn.Text = "REPLAY: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40, 40, 40)
    apBtn.Text = "AUTO PLAY: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40, 40, 40)
    recBtn.Text = recording and "STOP & SAVE" or "START RECORD"
    recBtn.BackgroundColor3 = recording and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(80, 30, 30)
end

-- ПЛЕЕР
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    task.spawn(function()
        local built = {}
        local begin = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end
            
            if step.action == "spawn" then
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok and tower then built[step.index] = tower end
            elseif step.action == "upgrade" then
                local tower = built[step.index]
                if not tower or not tower.Parent then
                    for _, v in pairs(workspace:FindFirstChild("Towers", true):GetChildren()) do
                        local p = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
                        if p and (p.Position - Vector3.new(step.x, step.y, step.z)).Magnitude < 2 then tower = v; built[step.index] = v; break end
                    end
                end
                if tower then
                    local ok, res = pcall(function() return UpgradeTower:InvokeServer(tower) end)
                    if ok and typeof(res) == "Instance" then built[step.index] = res end
                end
            elseif step.action == "skip" then
                pcall(function() if SkipWave:IsA("RemoteFunction") then SkipWave:InvokeServer() else SkipWave:FireServer() end end)
            end
        end
        playing = false
    end)
end

-- ХУКИ (ЗАПИСЬ - ТУТ ГЛАВНЫЙ ФИКС)
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    
    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local res = old(self, ...)
            local idx = #placed + 1
            placed[idx] = res -- Сохраняем первую ссылку
            local cf = args[2]
            table.insert(allMacros[currentSlot], {action="spawn", index=idx, id=tostring(args[1]), x=cf.X, y=cf.Y, z=cf.Z, t=os.clock()-startTime})
            return res
        
        elseif self == UpgradeTower and method == "InvokeServer" then
            local towerObj = args[1]
            local foundIndex = nil
            
            -- Сначала ищем по ссылке
            for i, v in pairs(placed) do if v == towerObj then foundIndex = i break end end
            
            -- Если по ссылке не нашли (башня обновилась), ищем по позиции
            if not foundIndex and towerObj.PrimaryPart then
                local pos = towerObj.PrimaryPart.Position
                for i, v in pairs(allMacros[currentSlot]) do
                    if v.action == "spawn" and (Vector3.new(v.x, v.y, v.z) - pos).Magnitude < 2 then
                        foundIndex = v.index
                        placed[v.index] = towerObj -- Обновляем ссылку на новую модель
                        break
                    end
                end
            end
            
            if foundIndex then
                local p = towerObj.PrimaryPart or towerObj:FindFirstChild("HumanoidRootPart")
                table.insert(allMacros[currentSlot], {
                    action="upgrade", index=foundIndex, t=os.clock()-startTime,
                    x=p and p.Position.X or 0, y=p and p.Position.Y or 0, z=p and p.Position.Z or 0
                })
            end
        elseif SkipWave and self == SkipWave and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action="skip", t=os.clock()-startTime})
        end
    end
    return old(self, ...)
end)

-- КНОПКИ УПРАВЛЕНИЯ
slotBtn.MouseButton1Click:Connect(function() if not recording then currentSlot = (currentSlot % SLOTS) + 1 saveSettings(); updateUI() end end)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveSettings(); updateUI() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveSettings(); updateUI() end)
playBtn.MouseButton1Click:Connect(doPlay)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    local f = "macro_s"..currentSlot..".json"
    if isfile(f) then delfile(f) end
    updateUI()
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    else
        recording = false
        writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
    end
    updateUI()
end)

-- ИНИЦИАЛИЗАЦИЯ
loadSettings()
for i=1, SLOTS do pcall(function() if isfile("macro_s"..i..".json") then allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) end end) end
updateUI()

