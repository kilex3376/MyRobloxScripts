local recBtn = btn(mainPanel, "RECORD", UDim2.new(0, 10, 0, 65), UDim2.new(1, -20, 0, 28))
local stopBtn = btn(mainPanel, "STOP RECORD", UDim2.new(0, 10, 0, 98), UDim2.new(1, -20, 0, 28))
local playBtn = btn(mainPanel, "PLAY", UDim2.new(0, 10, 0, 131), UDim2.new(1, -20, 0, 28))

local arBtn = btn(setPanel, "AUTO REPLAY: OFF", UDim2.new(0, 10, 0, 30), UDim2.new(1, -20, 0, 28))
local apBtn = btn(setPanel, "AUTO PLAY: OFF", UDim2.new(0, 10, 0, 63), UDim2.new(1, -20, 0, 28))
local delBtn = btn(setPanel, "DELETE MACRO", UDim2.new(0, 10, 0, 96), UDim2.new(1, -20, 0, 22), Color3.fromRGB(120, 35, 35))
local stopAutoBtn = btn(setPanel, "STOP ALL", UDim2.new(0, 10, 0, 125), UDim2.new(1, -20, 0, 22), Color3.fromRGB(70, 70, 70))

local function updateUI()
    for i = 1, SLOTS do
        slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(80, 70, 180) or Color3.fromRGB(40, 40, 40)
        slotBtns[i].Text = "S"..i.." ("..#allMacros[i]..")"
    end
end

for i = 1, SLOTS do
    slotBtns[i].MouseButton1Click:Connect(function()
        if not recording and not playing then currentSlot = i updateUI() end
    end)
end

--================ ЛОГИКА PLAY ================--
local function startPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    statusLbl.Text = "PLAYING SLOT "..currentSlot
    
    task.spawn(function()
        local built = {}
        local startT = os.clock()
        
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < startT + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    local ok, t = SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                    if ok and t then built[step.index] = t end
                elseif step.action == "upgrade" and built[step.index] then
                    local ok, nt = UpgradeTower:InvokeServer(built[step.index])
                    if ok and typeof(nt) == "Instance" then built[step.index] = nt end
                elseif step.action == "delete" and built[step.index] then
                    for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
                        if r.Name == "SellTower" or r.Name == "DeleteTower" then r:InvokeServer(built[step.index]) break end
                    end
                end
            end)
        end
        
        statusLbl.Text = "WAITING END..."
        while playing do
            local replay = lp.PlayerGui:FindFirstChild("GameGui") and lp.PlayerGui.GameGui:FindFirstChild("EndScreen") and lp.PlayerGui.GameGui.EndScreen:FindFirstChild("Replay")
            if replay and replay.Visible then
                if autoReplay then
                    setReplayFlag(currentSlot)
                    task.wait(2)
                    TeleportService:Teleport(game.PlaceId, lp)
                end
                break
            end
            task.wait(1)
        end
        playing = false
        updateUI()
    end)
end

--================ ХУК ЗАПИСИ ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method, args = getnamecallmethod(), {...}
    if recording and not checkcaller() and method == "InvokeServer" then
        if self == SpawnTower then
            if os.clock() - lastSpawnTime < 0.2 then return old(self, ...) end
            lastSpawnTime = os.clock()
            local res = old(self, ...)
            if res then
                local idx = #placed + 1
                placed[idx] = res
                table.insert(allMacros[currentSlot], {action = "spawn", id = args[1], x = args[2].X, y = args[2].Y, z = args[2].Z, index = idx, t = os.clock() - startTime})
            end
            return res
        elseif self == UpgradeTower then
            for i, v in pairs(placed) do
                if v == args[1] then
                    table.insert(allMacros[currentSlot], {action = "upgrade", index = i, t = os.clock() - startTime})
                    break
                end
            end
        end
    end
    return old(self, ...)
end)

recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    statusLbl.Text = "RECORDING..."
    task.spawn(function()
        while recording do
            task.wait(0.3)
            for i, v in pairs(placed) do
                if v and v.Parent == nil then
                    table.insert(allMacros[currentSlot], {action = "delete", index = i, t = os.clock() - startTime})
                    placed[i] = nil
                end
            end
        end
    end)
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    statusLbl.Text = "SAVED"
    if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    task.wait(0.5)
    updateUI()
end)

playBtn.MouseButton1Click:Connect(startPlay)

arBtn.MouseButton1Click:Connect(function()
    autoReplay = not autoReplay
    arBtn.Text = "AUTO REPLAY: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30,140,30) or Color3.fromRGB(40,40,40)
    if not autoReplay then clearReplayFlag() end
end)

apBtn.MouseButton1Click:Connect(function()
    autoPlay = not autoPlay
    apBtn.Text = "AUTO PLAY: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30,140,30) or Color3.fromRGB(40,40,40)
    if writefile then writefile(AUTOPLAY_FILE, HttpService:JSONEncode({enabled = autoPlay})) end
    if autoPlay and not playing then startPlay() end
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if writefile then pcall(function() delfile("macro_s"..currentSlot..".json") end) end
    updateUI()
    statusLbl.Text = "DELETED SLOT "..currentSlot
end)

stopAutoBtn.MouseButton1Click:Connect(function()
    playing, recording, autoReplay, autoPlay = false, false, false, false
    clearReplayFlag()
    arBtn.Text, arBtn.BackgroundColor3 = "AUTO REPLAY: OFF", Color3.fromRGB(40,40,40)
    apBtn.Text, apBtn.BackgroundColor3 = "AUTO PLAY: OFF", Color3.fromRGB(40,40,40)
    statusLbl.Text = "STOPPED ALL"
end)

--================ СТАРТ ================--
task.spawn(function()
    for i = 1, SLOTS do
        if isfile and isfile("macro_s"..i..".json") then
            pcall(function() allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) end)
        end
    end
    if isfile and isfile(AUTOPLAY_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(AUTOPLAY_FILE)) end)
        if ok and data.enabled then
            autoPlay = true
            apBtn.Text, apBtn.BackgroundColor3 = "AUTO PLAY: ON", Color3.fromRGB(30,140,30)
        end
    end
    updateUI()
    local s = getReplayFlag()
    if s then
        currentSlot = s
        autoReplay = true
        arBtn.Text, arBtn.BackgroundColor3 = "AUTO REPLAY: ON", Color3.fromRGB(30,140,30)
        task.wait(5)
        startPlay()
    elseif autoPlay then
        task.wait(5)
        startPlay()
    end
end)
