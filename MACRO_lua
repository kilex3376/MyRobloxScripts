local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, MoneyValue, AutoSkip, SkipWave

-- ПОИСК РЕМОУТОВ (ЛОГИКА 1:1)
task.spawn(function()
    while not SpawnTower or not UpgradeTower do
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" then SpawnTower = v
            elseif v.Name == "UpgradeTower" then UpgradeTower = v
            elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then SkipWave = v
            elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkip = v end
        end
        pcall(function() MoneyValue = lp.PlayerGui.HUD.Main.Top.Cash end)
        task.wait(1)
    end
end)

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {}
local startTime = 0
local autoReplay, autoPlay = false, false

local FLAG_FILE = "macro_autoreplay_v2.json"
local AUTOPLAY_FILE = "macro_autoplay.json"

-- ФУНКЦИИ ФЛАГОВ
local function setReplayFlag(slot) if writefile then writefile(FLAG_FILE, HttpService:JSONEncode({slot = slot})) end end
local function clearReplayFlag() if writefile then writefile(FLAG_FILE, "{}") end end
local function getReplayFlag()
    if isfile and isfile(FLAG_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FLAG_FILE)) end)
        return (ok and data and data.slot) and data.slot or nil
    end
    return nil
end

