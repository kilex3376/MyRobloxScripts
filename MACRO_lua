-- // ЛОГИКА ПОИСКА И ПЛЕЕРА
local function findTowerAtPos(x, y, z)
    local targetPos = Vector3.new(x, y, z)
    local folder = workspace:FindFirstChild("Towers", true) or workspace
    for _, v in pairs(folder:GetChildren()) do
        local p = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
        if p and (p.Position - targetPos).Magnitude < 2.5 then return v end
    end
    return nil
end

local function doPlay()
    if #allMacros[currentSlot] == 0 or playing then return end
    playing = true
    task.spawn(function()
        local built = {} 
        local begin = os.clock()
        for i, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < begin + step.t do 
                status.Text = string.format("Wait: %.1fs", (begin + step.t) - os.clock())
                RunService.Heartbeat:Wait() 
            end

            if step.action == "spawn" then
                status.Text = "Spawning..."
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok and tower then built[step.index] = tower end
            elseif step.action == "upgrade" then
                status.Text = "Upgrading..."
                local tower = built[step.index]
                local waitStart = os.clock()
                while (not tower or not tower.Parent) and (os.clock() - waitStart < 5) do
                    tower = findTowerAtPos(step.x, step.y, step.z)
                    if tower then built[step.index] = tower break end
                    task.wait(0.5)
                end
                if tower then pcall(function() 
                    local res = UpgradeTower:InvokeServer(tower)
                    if typeof(res) == "Instance" then built[step.index] = res end
                end) end
            elseif step.action == "skip" or step.action == "autoskip" then
                local rem = (step.action == "skip") and SkipWave or AutoSkip
                pcall(function() if rem:IsA("RemoteFunction") then rem:InvokeServer(step.value) else rem:FireServer(step.value) end end)
            end
        end
        playing = false
        status.Text = "Finished"
    end)
end

-- // ХУКИ
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local res = old(self, ...)
            local idx = #placed + 1
            placed[idx] = res
            local cf = args[2]
            table.insert(allMacros[currentSlot], {action="spawn", index=idx, id=tostring(args[1]), x=cf.Position.X, y=cf.Position.Y, z=cf.Position.Z, t=os.clock()-startTime})
            return res
        elseif self == UpgradeTower and method == "InvokeServer" then
            local tower = args[1]
            local foundIdx = nil
            for i, v in pairs(placed) do if v == tower then foundIdx = i break end end
            if foundIdx then 
                local p = tower.PrimaryPart or tower:FindFirstChild("HumanoidRootPart")
                table.insert(allMacros[currentSlot], {action="upgrade", index=foundIdx, t=os.clock()-startTime, x=p.Position.X, y=p.Position.Y, z=p.Position.Z}) 
            end
        elseif (self == SkipWave or self == AutoSkip) and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action=(self == AutoSkip and "autoskip" or "skip"), value=args[1], t=os.clock()-startTime})
        end
    end
    return old(self, ...)
end)

-- // УПРАВЛЕНИЕ
recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
        status.Text = "Recording S"..currentSlot
    else
        recording = false
        writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
        status.Text = "Saved S"..currentSlot
    end
    updateToggles()
    refreshSlots()
end)

playBtn.MouseButton1Click:Connect(doPlay)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveSettings() updateToggles() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveSettings() updateToggles() end)
delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if isfile("macro_s"..currentSlot..".json") then delfile("macro_s"..currentSlot..".json") end
    refreshSlots()
end)

-- // AUTO REPLAY И ВИДИМОСТЬ
local function isActuallyVisible(guiObj)
    local cur = guiObj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

task.spawn(function()
    while task.wait(0.5) do
        local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
        if rb and isActuallyVisible(rb) then
            if recording then
                recording = false
                writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
                updateToggles()
            end
            if autoReplay and not playing then
                pcall(function() 
                    for _, c in ipairs(getconnections(rb.MouseButton1Click)) do c:Fire() end 
                    for _, c in ipairs(getconnections(rb.Activated)) do c:Fire() end
                end)
            end
        end
    end
end)

-- // ИНИЦИАЛИЗАЦИЯ
loadSettings()
for i = 1, SLOTS do
    local f = "macro_s"..i..".json"
    if isfile(f) then allMacros[i] = HttpService:JSONDecode(readfile(f)) end
end
updateToggles()
refreshSlots()
if autoPlay then task.delay(5, doPlay) end
