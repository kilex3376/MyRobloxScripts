local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local VIM = game:GetService("VirtualInputManager")

-- // ПОИСК REMOTES
local SpawnTower, UpgradeTower, SkipWave, AutoSkip
local function findRemotes()
    SpawnTower = ReplicatedStorage:FindFirstChild("SpawnNewTower", true)
    UpgradeTower = ReplicatedStorage:FindFirstChild("UpgradeTower", true)
    SkipWave = ReplicatedStorage:FindFirstChild("SkipWave", true) or ReplicatedStorage:FindFirstChild("VoteSkip", true)
    AutoSkip = ReplicatedStorage:FindFirstChild("AutoSkip", true) or ReplicatedStorage:FindFirstChild("ToggleAutoSkip", true)
end

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false
local SETTINGS_FILE = "macro_v27_final_fix.json"

local function saveAll()
    writefile(SETTINGS_FILE, HttpService:JSONEncode({autoReplay=autoReplay, autoPlay=autoPlay, currentSlot=currentSlot, macros=allMacros}))
end

local function loadAll()
    if isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok then 
            autoReplay=data.autoReplay or false
            autoPlay=data.autoPlay or false
            currentSlot=data.currentSlot or 1
            allMacros=data.macros or {{},{},{}} 
        end
    end
end
loadAll()

-- // GUI
