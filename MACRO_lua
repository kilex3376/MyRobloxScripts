local slotBtn = btn("SLOT: "..currentSlot, 10, 25)
local recBtn = btn("START RECORD", 40, 35, Color3.fromRGB(80, 35, 35))
local playBtn = btn("PLAY MACRO", 80, 35, Color3.fromRGB(35, 80, 35))
local arBtn = btn("REPLAY: OFF", 120, 28)
local apBtn = btn("AUTO: OFF", 153, 28)
local delBtn = btn("DELETE DATA", 190, 25, Color3.fromRGB(100, 20, 20))

local function updateUI()
    slotBtn.Text = "SLOT: "..currentSlot.." ("..#allMacros[currentSlot]..")"
    arBtn.Text = "REPLAY: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    apBtn.Text = "AUTO PLAY: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    recBtn.Text = recording and "STOP & SAVE" or "START RECORD"
    recBtn.BackgroundColor3 = recording and Color3.fromRGB(150, 30, 30) or Color3.fromRGB(80, 35, 35)
end

--================ КНОПКИ ================--
slotBtn.MouseButton1Click:Connect(function()
    if not recording then currentSlot = (currentSlot % SLOTS) + 1 saveSettings() updateUI() end
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then
        -- Очищаем данные (из твоего кода)
        allMacros[currentSlot], placed = {}, {}
        lastSpawnTime, lastSpawnPos = 0, nil
        startTime, recording = os.clock(), true
    else
        recording = false
        if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    end
    updateUI()
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if isfile and isfile("macro_s"..currentSlot..".json") then delfile("macro_s"..currentSlot..".json") end
    updateUI()
end)

arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveSettings() updateUI() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveSettings() updateUI() end)

-- ЗАПИСЬ ПЛЕЙ АГЕЙН (Наша фича)
RunService.Heartbeat:Connect(function()
    if recording then
        local replay = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
        if replay and replay.Visible then
            local c; c = replay.MouseButton1Click:Connect(function()
                if recording then
                    table.insert(allMacros[currentSlot], {action="rejoin", t=os.clock()-startTime})
                    recording = false
                    if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
                    updateUI()
                end
                c:Disconnect()
            end)
        end
    end
end)

--================ ХУКИ (Точно из твоего рабочего кода) ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local cf = args[2]
            if typeof(cf) == "CFrame" then
                local pos = cf.Position
                if tick() - lastSpawnTime > 0.35 or not lastSpawnPos or (lastSpawnPos - pos).Magnitude > 1 then
                    lastSpawnTime = tick()
                    lastSpawnPos = pos

                    local result = old(self, ...)
                    local index = #placed + 1
                    placed[index] = result

                    table.insert(allMacros[currentSlot], {
                        action = "spawn", index = index, id = tostring(args[1]),
                        x = pos.X, y = pos.Y, z = pos.Z, t = os.clock() - startTime
                    })
                    return result
                end
            end
        elseif self == UpgradeTower and method == "InvokeServer" then
            local tower = args[1]
            for i = #placed, 1, -1 do
                if placed[i] == tower then
                    table.insert(allMacros[currentSlot], {action = "upgrade", index = i, t = os.clock() - startTime})
                    break
                end
            end
        elseif SkipWave and self == SkipWave and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action = "skip", t = os.clock() - startTime})
        elseif AutoSkip and self == AutoSkip and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action = "autoskip", value = args[1], t = os.clock() - startTime})
        end
    end
    return old(self, ...)
end)

--================ ПЛЕЕР (Точно из твоего рабочего кода + наш Play Again) ================--
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    
    task.spawn(function()
        local built = {}
        local begin = os.clock()

        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end

            if step.action == "spawn" then
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok then built[step.index] = tower end
                task.wait(0.05)
            elseif step.action == "upgrade" then
                if built[step.index] then pcall(function() UpgradeTower:InvokeServer(built[step.index]) end) end
                task.wait(0.1)
            elseif step.action == "skip" then
                pcall(function() if SkipWave then if SkipWave:IsA("RemoteFunction") then SkipWave:InvokeServer() else SkipWave:FireServer() end end end)
            elseif step.action == "autoskip" then
                pcall(function() if AutoSkip then if AutoSkip:IsA("RemoteFunction") then AutoSkip:InvokeServer(step.value) else AutoSkip:FireServer(step.value) end end end)
            elseif step.action == "rejoin" then
                local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
                forceClick(rb)
            end
        end
        playing = false
    end)
end

playBtn.MouseButton1Click:Connect(doPlay)

-- ЗАГРУЗКА
loadSettings()
for i=1, SLOTS do pcall(function() if isfile and isfile("macro_s"..i..".json") then allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) end end) end
updateUI()

-- АВТО-ПЛЕЙ ПРИ ЗАХОДЕ
if autoPlay then task.delay(5, doPlay) end

