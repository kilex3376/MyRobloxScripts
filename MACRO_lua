local function updateToggles()
    arBtn.Text = "Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0,120,0) or Color3.fromRGB(40,40,40)
    apBtn.Text = "AutoPlay: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0,120,0) or Color3.fromRGB(40,40,40)
    recBtn.Text = recording and "STOP & SAVE" or "Record"
