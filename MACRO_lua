local function startPlay()
    if playing then return end

    if #allMacros[currentSlot] == 0 then
        if readfile and isfile and isfile("macro_s" .. currentSlot .. ".json") then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(readfile("macro_s" .. currentSlot .. ".json"))
            end)

            if ok and data then
                allMacros[currentSlot] = data
                macro = allMacros[currentSlot]
            end
        end
    end

    if #macro == 0 then
        status.Text = "Empty S" .. currentSlot
        return
    end

    playing = true
    status.Text = "Playing S" .. currentSlot

    task.spawn(function()
        local built = {}
        local begin = os.clock()

        for _, step in ipairs(macro) do
            while os.clock() < begin + step.t do
                RunService.Heartbeat:Wait()
            end

            if step.action == "spawn" then
                local ok, tower = pcall(function()
                    return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                end)

                if ok and tower then
                    built[step.index] = tower
                end

            elseif step.action == "upgrade" then
                if built[step.index] then
                    local ok, result = pcall(function()
                        return UpgradeTower:InvokeServer(built[step.index])
                    end)

                    if ok and typeof(result) == "Instance" then
                        built[step.index] = result
                    end
                end

            elseif step.action == "delete" then
                if built[step.index] then
                    pcall(function()
                        local tower = built[step.index]

                        for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                            if remote.Name == "SellTower" or remote.Name == "DeleteTower" or remote.Name == "RemoveTower" then
                                remote:InvokeServer(tower)
                                break
                            end
                        end

                        built[step.index] = nil
                    end)
                end
            end
        end

        autoSaveAll()

        status.Text = "Macro finished, waiting for victory..."

        local gui = Players.LocalPlayer:WaitForChild("PlayerGui")
        while true do
            local gameGui = gui:FindFirstChild("GameGui")
            local endScreen = gameGui and gameGui:FindFirstChild("EndScreen")
            local replay = endScreen and endScreen:FindFirstChild("Replay")

            if endScreen and endScreen.Visible and replay and replay.Visible then
                status.Text = "Victory screen loaded, waiting reward..."
                local oldCash = tostring(MoneyValue and MoneyValue.Text or "")
                local rewardStart = tick()

                while tick() - rewardStart < 20 do
                    local currentCash = tostring(MoneyValue and MoneyValue.Text or "")

                    if currentCash ~= oldCash then
                        status.Text = "Reward received"
                        task.wait(3)
                        break
                    end

                    task.wait(1)
                end
                break
            end

            task.wait(1)
        end

        playing = false

        if autoReplay then
            setReplayFlag(currentSlot)
            status.Text = "Waiting for Victory..."

            task.spawn(function()
                local gui = Players.LocalPlayer:WaitForChild("PlayerGui")

                while true do
                    local gameGui = gui:FindFirstChild("GameGui")
                    local endScreen = gameGui and gameGui:FindFirstChild("EndScreen")
                    local replay = endScreen and endScreen:FindFirstChild("Replay")

                    if replay and replay.Visible then
                        break
                    end

                    task.wait(1)
                end

                status.Text = "Victory detected"
                task.wait(5)

                print("=== REPLAY DEBUG START ===")
                local guiDebug = Players.LocalPlayer.PlayerGui
                local gameGuiDebug = guiDebug:FindFirstChild("GameGui")
                local endScreenDebug = gameGuiDebug and gameGuiDebug:FindFirstChild("EndScreen")

                if endScreenDebug then
                    print("EndScreen.Visible:", endScreenDebug.Visible)

                    for _,v in pairs(endScreenDebug:GetDescendants()) do
                        if v:IsA("TextButton") or v:IsA("ImageButton") then
                            print("BUTTON:", v:GetFullName(), "Visible:", v.Visible)
                        elseif v:IsA("TextLabel") then
                            print("LABEL:", v:GetFullName(), "TEXT:", v.Text, "Visible:", v.Visible)
                        end
                    end
                else
                    warn("EndScreen not found")
                end

                print("=== REPLAY DEBUG END ===")
                task.wait(10)

                local clicked = waitAndClickPlayAgain(15)

                if clicked then
                    status.Text = "Rejoining..."
                else
                    status.Text = "Open console and send [Macro] lines"
                end
            end)
        else
            clearReplayFlag()
            status.Text = "Done"
        end
    end)
end

recordButton.MouseButton1Click:Connect(function()
    if playing then return end

    allMacros[currentSlot] = {}
    macro = allMacros[currentSlot]
    placed = {}
    startTime = os.clock()
    recording = true

    task.spawn(function()
        local oldCount = #placed

        while recording do
            task.wait(0.2)

            for i, tower in pairs(placed) do
                if tower and tower.Parent == nil then
                    table.insert(macro, {
                        action = "delete",
                        index = i,
                        t = os.clock() - startTime
                    })

                    placed[i] = nil
                end
            end
        end
    end)

    status.Text = "Recording"
    refreshSlots()
end)

