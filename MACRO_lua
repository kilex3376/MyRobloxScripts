local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TeleportService = game:GetService("TeleportService")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, MoneyValue, SkipWaveRemote, AutoSkipRemote

-- Функция поиска ремоутов
local function findRemotes()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SpawnNewTower" then SpawnTower = v
        elseif v.Name == "UpgradeTower" then UpgradeTower = v
        elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then SkipWaveRemote = v
        elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkipRemote = v end
    end
end

task.spawn(function()
    while not SpawnTower do
        findRemotes()
        pcall(function() MoneyValue = lp.PlayerGui.HUD.Main.Top.Cash end)
        task.wait(1)
    end
end)

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {}
local startTime, lastSpawnTime = 0, 0
local autoReplay, autoPlay = false, false

local FLAG_FILE = "macro_autoreplay_v2.json"
local AUTOPLAY_FILE = "macro_autoplay.json"

local function setReplayFlag(s) if writefile then writefile(FLAG_FILE, HttpService:JSONEncode({slot = s})) end end
local function clearReplayFlag() if writefile then writefile(FLAG_FILE, "{}") end end
local function getReplayFlag()
    if isfile and isfile(FLAG_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FLAG_FILE)) end)
        return (ok and data and data.slot) and data.slot or nil
    end
    return nil
end

--================ GUI (ДВЕ ПАНЕЛИ) ================--
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "MacroUI_Fixed_V2"
ui.ResetOnSpawn = false

local function createPanel(name, pos, size)
    local f = Instance.new("Frame", ui)
    f.Name = name
    f.Size, f.Position = size, pos
    f.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    f.BorderSizePixel = 0
    f.Active, f.Draggable = true, true
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
    return f
end

