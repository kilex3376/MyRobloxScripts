local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TeleportService = game:GetService("TeleportService")

local lp = Players.LocalPlayer
local remotes = {spawn = nil, upgrade = nil, skip = nil}

-- Поиск Remotes (универсальный)
local function findRemotes()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        local n = v.Name:lower()
        if v:IsA("RemoteFunction") or v:IsA("RemoteEvent") then
            if n:find("place") or n:find("spawn") then remotes.spawn = v
            elseif n:find("upgrade") then remotes.upgrade = v
            elseif n:find("skip") then remotes.skip = v end
        end
    end
end
findRemotes()

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

local function save()
    if writefile then
        writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
    end
end

-- Улучшенная функция клика
local function forceClick(btn)
    if not btn or not btn.Visible then return end
    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 1)
        task.wait(0.1)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 1)
    end)
end

--================ GUI (Твой стиль) ================--
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_V11_Final"
ui.ResetOnSpawn = false

local main = Instance.new("Frame", ui)
main.Size = UDim2.new(0, 150, 0, 230) -- Чуть увеличил высоту для кнопки удаления
main.Position = UDim2.new(0, 50, 0.5, -115)
main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
main.Active, main.Draggable = true, true
Instance.new("UICorner", main)

local function btn(txt, y, h, color)
    local b = Instance.new("TextButton", main)
    b.Size, b.Position = UDim2.new(1, -14, 0, h), UDim2.new(0, 7, 0, y)
    b.Text, b.BackgroundColor3 = txt, color or Color3.fromRGB(45, 45, 45)
    b.TextColor3, b.Font, b.TextSize = Color3.new(1,1,1), Enum.Font.GothamBold, 10
    Instance.new("UICorner", b)
    return b
end

local slotBtn = btn("SLOT: "..currentSlot, 10, 25)
local recBtn = btn("START RECORD", 40, 35, Color3.fromRGB(80, 35, 35))
local playBtn = btn("PLAY MACRO", 80, 35, Color3.fromRGB(35, 80, 35))
local arBtn = btn("REPLAY: OFF", 120, 28)
local apBtn = btn("AUTO: OFF", 153, 28)
local delBtn = btn("DELETE MACRO", 190, 25, Color3.fromRGB(120, 30, 30)) -- Кнопка удаления

local function updateUI()
    slotBtn.Text = "SLOT: "..currentSlot.." ("..#allMacros[currentSlot]..")"
    arBtn.Text = "REPLAY: "..(autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    apBtn.Text = "AUTO: "..(autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    recBtn.Text = recording and "STOP & SAVE" or "START RECORD"
    recBtn.BackgroundColor3 = recording and Color3.fromRGB(150, 30, 30) or Color3.fromRGB(80, 35, 35)
end

--================ PLAY ================--
local function startPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing, startTime = true, os.clock()
    updateUI()
    
    task.spawn(function()
        local currentPlaced = {}
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < startTime + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    local ok, obj = remotes.spawn:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                    currentPlaced[step.index] = obj
                elseif step.action == "upgrade" and currentPlaced[step.index] then
                    remotes.upgrade:InvokeServer(currentPlaced[step.index])
                elseif step.action == "skip" then
                    if remotes.skip:IsA("RemoteEvent") then remotes.skip:FireServer() else remotes.skip:InvokeServer() end
                elseif step.action == "rejoin" then
                    local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
                    if rb then forceClick(rb) end
                end
            end)
        end
        
        -- Если авто-реплей включен, ищем кнопку до победного
        while playing and autoReplay do
            local replay = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
            if replay and replay.Visible then
                task.wait(2)
                forceClick(replay)
                task.wait(5)
                TeleportService:Teleport(game.PlaceId)
                break
            end
            task.wait(2)
        end
        playing = false
        updateUI()
    end)
end

--================ ХУКИ ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if recording and not checkcaller() then
        if self == remotes.spawn then
            local res = old(self, ...)
            table.insert(allMacros[currentSlot], {action="spawn", id=args[1], x=args[2].X, y=args[2].Y, z=args[2].Z, index=#placed+1, t=os.clock()-startTime})
            table.insert(placed, res or "dummy")
            return res
        elseif self == remotes.upgrade then
            for i, v in pairs(placed) do
                if v == args[1] then
                    table.insert(allMacros[currentSlot], {action="upgrade", index=i, t=os.clock()-startTime})
                    break
                end
            end
        elseif self == remotes.skip then
            table.insert(allMacros[currentSlot], {action="skip", t=os.clock()-startTime})
        end
    end
    return old(self, ...)
end)

-- Слежка за кнопкой Replay (для записи)
RunService.Heartbeat:Connect(function()
    if recording then
        local replay = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
        if replay and replay.Visible then
            -- Записываем факт нажатия
            local conn; conn = replay.MouseButton1Click:Connect(function()
                if recording then
                    table.insert(allMacros[currentSlot], {action="rejoin", t=os.clock()-startTime})
                    recording = false
                    save()
                    updateUI()
                end
                conn:Disconnect()
            end)
        end
    end
end)

--================ КНОПКИ ================--
slotBtn.MouseButton1Click:Connect(function()
    if not recording then 
        currentSlot = (currentSlot % SLOTS) + 1 
        -- Загрузка макроса при смене слота
        pcall(function()
            if isfile and isfile("macro_s"..currentSlot..".json") then
                allMacros[currentSlot] = HttpService:JSONDecode(readfile("macro_s"..currentSlot..".json"))
            else
                allMacros[currentSlot] = {}
            end
        end)
        updateUI() 
    end
end)

recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    if not recording then
        allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    else
        recording = false
        save()
    end
    updateUI()
end)

playBtn.MouseButton1Click:Connect(startPlay)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay updateUI() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay updateUI() end)

delBtn.MouseButton1Click:Connect(function()
    if not recording and not playing then
        allMacros[currentSlot] = {}
        if isfile and isfile("macro_s"..currentSlot..".json") then
            delfile("macro_s"..currentSlot..".json")
        end
        updateUI()
    end
end)

-- Начальная загрузка
pcall(function()
    if isfile and isfile("macro_s"..currentSlot..".json") then
        allMacros[currentSlot] = HttpService:JSONDecode(readfile("macro_s"..currentSlot..".json"))
    end
end)
updateUI()
