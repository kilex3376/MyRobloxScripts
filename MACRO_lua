local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false
local SETTINGS_FILE = "macro_v29_7.json"

-- // СОХРАНЕНИЕ/ЗАГРУЗКА
local function saveAll()
    local success, err = pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay,
            autoPlay = autoPlay,
            currentSlot = currentSlot,
            macros = allMacros
        }))
    end)
end

local function loadAll()
    if isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok then 
            autoReplay = data.autoReplay or false
            autoPlay = data.autoPlay or false
            currentSlot = data.currentSlot or 1
            allMacros = data.macros or {{},{},{}} 
        end
    end
end
loadAll()

-- // GUI
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "Macro_V29_7_FIXED"
gui.ResetOnSpawn = false
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 340) 
frame.Position = UDim2.new(0, 20, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.Text = "READY"
status.BackgroundTransparency = 1

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(35, 35, 35)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
end

-- Кнопки выбора слотов
for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 25)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function() currentSlot = i updateUI() end)
end

local function makeBtn(txt, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,35)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(45,45,45)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 14
    Instance.new("UICorner", b)
    return b
end

-- ВОТ ОНИ, ТВОИ КНОПКИ БЛЯТЬ:
local recBtn = makeBtn("RECORD", 60, Color3.fromRGB(130,0,0))
local playBtn = makeBtn("PLAY", 105, Color3.fromRGB(0,110,0))
local arBtn = makeBtn("Auto Replay: OFF", 150)
local apBtn = makeBtn("Auto Play: OFF", 195)
local delBtn = makeBtn("CLEAR SLOT", 240)

local function updateToggles()
    arBtn.Text = "Auto Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0,100,0) or Color3.fromRGB(45,45,45)
    apBtn.Text = "Auto Play: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0,100,0) or Color3.fromRGB(45,45,45)
end

-- // ПЛЕЕР
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local start = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock() - start) < step.t do task.wait() end
            pcall(function()
                local remote = game:FindFirstChild(step.name, true)
                if remote then
                    if remote:IsA("RemoteFunction") then remote:InvokeServer(unpack(step.args))
                    else remote:FireServer(unpack(step.args)) end
                end
            end)
        end
        playing = false
        status.Text = "DONE"
    end)
end

-- // ХУК ЗАПИСИ
local oldNC; oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    if recording and not checkcaller() then
        if self:IsA("RemoteFunction") or self:IsA("RemoteEvent") then
            if self.Name ~= "SayMessageRequest" and not self.Name:find("Move") then
                table.insert(allMacros[currentSlot], {
                    name = self.Name,
                    args = args,
                    t = os.clock() - startTime
                })
                task.spawn(updateUI)
            end
        end
    end
    return oldNC(self, ...)
end)

-- // ОБРАБОТКА КЛИКОВ КНОПОК
recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot] = {}
        startTime = os.clock()
        recording = true
        status.Text = "RECORDING..."
    else
        recording = false
        saveAll()
        status.Text = "READY"
    end
    updateUI()
end)

playBtn.MouseButton1Click:Connect(doPlay)

arBtn.MouseButton1Click:Connect(function() 
    autoReplay = not autoReplay 
    updateToggles()
    saveAll()
end)

apBtn.MouseButton1Click:Connect(function() 
    autoPlay = not autoPlay 
    updateToggles()
    saveAll()
end)

delBtn.MouseButton1Click:Connect(function() 
    allMacros[currentSlot] = {} 
    updateUI() 
    saveAll()
end)

-- // АВТОРЕПЛЕЙ ЛОГИКА
task.spawn(function()
    while task.wait(1) do
        if autoReplay and not playing and not recording then
            for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") and v.Visible and (v.Text:lower():find("again") or v.Name:lower():find("Retry")) then
                    for _, c in ipairs(getconnections(v.MouseButton1Click)) do c:Fire() end
                end
            end
        end
    end
end)

updateUI()
updateToggles()
