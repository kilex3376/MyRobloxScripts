local slotBtns = {}
for i = 1, SLOTS do
    slotBtns[i] = btn(mainPanel, "S"..i, UDim2.new(0, 10 + (i-1)*62, 0, 40), UDim2.new(0, 56, 0, 30))
end

local recBtn = btn(mainPanel, "RECORD", UDim2.new(0, 10, 0, 80), UDim2.new(1, -20, 0, 35))
local stopBtn = btn(mainPanel, "STOP RECORD", UDim2.new(0, 10, 0, 120), UDim2.new(1, -20, 0, 35))
local playBtn = btn(mainPanel, "PLAY MACRO", UDim2.new(0, 10, 0, 160), UDim2.new(1, -20, 0, 35))

local arBtn = btn(setPanel, "Auto-Replay: OFF", UDim2.new(0, 10, 0, 45), UDim2.new(1, -20, 0, 35))
local apBtn = btn(setPanel, "Auto-Play: OFF", UDim2.new(0, 10, 0, 85), UDim2.new(1, -20, 0, 35))
local delBtn = btn(setPanel, "DELETE SLOT DATA", UDim2.new(0, 10, 0, 125), UDim2.new(1, -20, 0, 25), Color3.fromRGB(120, 40, 40))
local stopAllBtn = btn(setPanel, "EMERGENCY STOP", UDim2.new(0, 10, 0, 155), UDim2.new(1, -20, 0, 25), Color3.fromRGB(70, 70, 70))

local function updateUI()
    for i = 1, SLOTS do
        slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(80, 70, 200) or Color3.fromRGB(45, 45, 45)
        slotBtns[i].Text = "S"..i.." ("..#allMacros[i]..")"
    end
    statusLbl.Text = playing and "PLAYING..." or (recording and "RECORDING..." or "Slot "..currentSlot.." Ready")
end

--================ ЛОГИКА PLAY (С АВТО-СКИПОМ) ================--
local function startPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    updateUI()
    
    task.spawn(function()
        -- Активация авто-скипа при старте
        if AutoSkipRemote then pcall(function() AutoSkipRemote:InvokeServer(true) end) end
        
        local built = {}
        local startT = os.clock()
        
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < startT + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    local ok, t = SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                    if ok and t then built[step.index] = t end
                elseif step.action == "upgrade" and built[step.index] then
                    UpgradeTower:InvokeServer(built[step.index])
                elseif step.action == "delete" and built[step.index] then
                    for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
                        if r.Name == "SellTower" or r.Name == "DeleteTower" then r:InvokeServer(built[step.index]) break end
                    end
                end
            end)
        end
        
        -- Логика авто-реплея
        while playing do
            local gui = lp.PlayerGui:FindFirstChild("GameGui")
            local replay = gui and gui:FindFirstChild("EndScreen") and (gui.EndScreen:FindFirstChild("Replay") or gui.EndScreen:FindFirstChild("Play Again"))
            if replay and replay.Visible then
                if autoReplay then
                    setReplayFlag(currentSlot)
                    task.wait(2)
                    pcall(function() replay:Activate() end)
                    task.wait(2)
                    TeleportService:Teleport(game.PlaceId, lp)
                end
                break
            end
            task.wait(1)
        end
        playing = false
        updateUI()
    end)
end

--================ ХУК ДЛЯ ЗАПИСИ ПРОКАЧКИ ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    
    if recording and not checkcaller() and method == "InvokeServer" then
        if self == SpawnTower then
            local res = old(self, ...)
            if res then
                local idx = #placed + 1
                placed[idx] = res
                table.insert(allMacros[currentSlot], {action = "spawn", id = args[1], x = args[2].X, y = args[2].Y, z = args[2].Z, index = idx, t = os.clock() - startTime})
            end
            return res
        elseif self == UpgradeTower then
            -- Ищем, какой именно юнит прокачивается
            for i, v in pairs(placed) do
                if v == args[1] then
                    table.insert(allMacros[currentSlot], {action = "upgrade", index = i, t = os.clock() - startTime})
                    break
                end
            end
        end
    end
    return old(self, ...)
end)

--================ КНОПКИ ================--
recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    updateUI()
    task.spawn(function()
        while recording do
            task.wait(0.3)
            for i, v in pairs(placed) do
                if v and v.Parent == nil then
                    table.insert(allMacros[currentSlot], {action = "delete", index = i, t = os.clock() - startTime})
                    placed[i] = nil
                end
            end
        end
    end)
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    updateUI()
end)

playBtn.MouseButton1Click:Connect(startPlay)

arBtn.MouseButton1Click:Connect(function()
    autoReplay = not autoReplay
    arBtn.Text = "Auto-Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30,140,30) or Color3.fromRGB(45,45,45)
    if not autoReplay then clearReplayFlag() end
end)

apBtn.MouseButton1Click:Connect(function()
    autoPlay = not autoPlay
    apBtn.Text = "Auto-Play: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30,140,30) or Color3.fromRGB(45,45,45)
    if writefile then writefile(AUTOPLAY_FILE, HttpService:JSONEncode({enabled = autoPlay})) end
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if writefile then pcall(function() delfile("macro_s"..currentSlot..".json") end) end
    updateUI()
end)

stopAllBtn.MouseButton1Click:Connect(function()
    playing, recording = false, false
    updateUI()
end)

--================ ЗАГРУЗКА И АВТОЗАПУСК ================--
task.spawn(function()
    for i = 1, SLOTS do
        if isfile and isfile("macro_s"..i..".json") then
            pcall(function() allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) end)
        end
    end
    if isfile and isfile(AUTOPLAY_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(AUTOPLAY_FILE)) end)
        if ok and data.enabled then autoPlay = true apBtn.BackgroundColor3 = Color3.fromRGB(30,140,30) apBtn.Text = "Auto-Play: ON" end
    end
    updateUI()
    
    local s = getReplayFlag()
    if s then
        currentSlot = s
        autoReplay = true
        arBtn.BackgroundColor3 = Color3.fromRGB(30,140,30)
        arBtn.Text = "Auto-Replay: ON"
        clearReplayFlag()
        task.wait(5)
        startPlay()
    elseif autoPlay then
        task.wait(5)
        startPlay()
    end
end)
