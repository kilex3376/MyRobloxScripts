local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipWave, AutoSkip, MoneyValue

-- // ТВОЙ ПОИСК REMOTES (С фиксом поиска Cash)
task.spawn(function()
    while not SpawnTower or not UpgradeTower do
        for _,v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" then SpawnTower = v
            elseif v.Name == "UpgradeTower" then UpgradeTower = v
            elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then SkipWave = v
            elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkip = v
            end
        end
        pcall(function()
            MoneyValue = lp:WaitForChild("PlayerGui"):WaitForChild("HUD"):WaitForChild("Main"):WaitForChild("Top"):WaitForChild("Cash")
        end)
        task.wait(1)
    end
end)

-- // Слоты и переменные
local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local placed = {} 
local startTime = 0

-- // GUI (Твой дизайн)
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "MacroV23_Final"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 220) -- Чуть увеличил для доп. кнопки
frame.Position = UDim2.new(0, 20, 0.5, -110)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true
Instance.new("UICorner", frame).CornerRadius = UDim.new(0,10)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,25)
title.Text = "Macro V23"
title.TextColor3 = Color3.new(1,1,1)
title.BackgroundTransparency = 1
title.Font = Enum.Font.SourceSansBold
title.TextSize = 20

local slotBtns = {}
local function refreshSlots()
    for i = 1, SLOTS do
        slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(80,80,200) or Color3.fromRGB(40,40,40)
        slotBtns[i].Text = "S"..i.." ("..#allMacros[i]..")"
    end
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 22)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 28)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function()
        if not recording and not playing then currentSlot = i refreshSlots() end
    end)
end

local function makeButton(text, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,170,0,30)
    b.Position = UDim2.new(0,10,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 18
    b.Text = text
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    return b
end

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,20)
status.Position = UDim2.new(0,0,1,-25)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.new(1,1,1)
status.Text = "Ready"

local recBtn = makeButton("Record", 58, Color3.fromRGB(60,20,20))
local stopBtn = makeButton("Stop & Save", 94)
local playBtn = makeButton("Play", 130, Color3.fromRGB(20,60,20))
local delBtn = makeButton("Delete Slot", 166, Color3.fromRGB(100,20,20))

-- // ЛОГИКА ЗАПИСИ (ХУКИ) - ТУТ ГЛАВНЫЙ ИСПРАВЛЕННЫЙ БЛОК
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local res = old(self, ...)
            local idx = #placed + 1
            placed[idx] = res -- Сохраняем ссылку
            local cf = args[2]
            table.insert(allMacros[currentSlot], {
                action = "spawn", index = idx, id = tostring(args[1]),
                x = cf.Position.X, y = cf.Position.Y, z = cf.Position.Z,
                t = os.clock() - startTime
            })
            return res
        elseif self == UpgradeTower and method == "InvokeServer" then
            local tower = args[1]
            local foundIdx = nil
            -- Ищем по ссылке
            for i, v in pairs(placed) do if v == tower then foundIdx = i break end end
            -- Если ссылка изменилась (апгрейд выше 2 уровня), ищем по позиции
            if not foundIdx and tower.PrimaryPart then
                local p = tower.PrimaryPart.Position
                for i, step in ipairs(allMacros[currentSlot]) do
                    if step.action == "spawn" and (Vector3.new(step.x, step.y, step.z) - p).Magnitude < 2 then
                        foundIdx = step.index
                        placed[foundIdx] = tower -- Обновляем ссылку на новую модель
                        break
                    end
                end
            end
            if foundIdx then
                table.insert(allMacros[currentSlot], {action="upgrade", index=foundIdx, t=os.clock()-startTime})
            end
        elseif (self == SkipWave or self == AutoSkip) and (method == "InvokeServer" or method == "FireServer") then
            local act = (self == AutoSkip) and "autoskip" or "skip"
            table.insert(allMacros[currentSlot], {action=act, value=args[1], t=os.clock()-startTime})
        end
    end
    return old(self, ...)
end)

-- // КНОПКИ
recBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    status.Text = "Recording..."
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
    refreshSlots()
    status.Text = "Saved Slot "..currentSlot
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    local f = "macro_s"..currentSlot..".json"
    if isfile(f) then delfile(f) end
    refreshSlots()
    status.Text = "Deleted Slot "..currentSlot
end)

playBtn.MouseButton1Click:Connect(function()
    if #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "Playing..."
    task.spawn(function()
        local built = {}
        local begin = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end

            if step.action == "spawn" then
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok then built[step.index] = tower end
            elseif step.action == "upgrade" then
                local tower = built[step.index]
                -- ФИКС: Если модель заменилась, ищем по координатам
                if not tower or not tower.Parent then
                    for _, v in pairs(workspace:FindFirstChild("Towers", true):GetChildren()) do
                        local p = v.PrimaryPart or v:FindFirstChild("HumanoidRootPart")
                        if p and (p.Position - Vector3.new(step.x, step.y, step.z)).Magnitude < 2 then
                            tower = v; built[step.index] = v; break
                        end
                    end
                end
                if tower then 
                    local ok, res = pcall(function() return UpgradeTower:InvokeServer(tower) end)
                    if ok and typeof(res) == "Instance" then built[step.index] = res end
                end
            elseif step.action == "skip" or step.action == "autoskip" then
                local rem = (step.action == "skip") and SkipWave or AutoSkip
                pcall(function() if rem:IsA("RemoteFunction") then rem:InvokeServer(step.value) else rem:FireServer(step.value) end end)
            end
        end
        playing = false
        status.Text = "Finished"
    end)
end)

-- Загрузка при старте
for i = 1, SLOTS do
    local f = "macro_s"..i..".json"
    if isfile(f) then allMacros[i] = HttpService:JSONDecode(readfile(f)) end
end
refreshSlots()
