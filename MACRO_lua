    if writefile then pcall(function() delfile("macro_s"..currentSlot..".json") end) end
    status.Text = "Deleted S" .. currentSlot
end)

-- АВТОСТАРТ ПРИ ЗАГРУЗКЕ
task.spawn(function()
    local s = getReplayFlag()
    if s then
        currentSlot = s
        autoReplay = true
        if isfile("macro_s"..s..".json") then
            allMacros[s] = HttpService:JSONDecode(readfile("macro_s"..s..".json"))
            task.wait(5)
            startPlay()
        end
    end
end)
