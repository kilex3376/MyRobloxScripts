local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local VIM = game:GetService("VirtualInputManager")

-- // ПОИСК REMOTES
local SpawnTower, UpgradeTower, SkipWave, AutoSkip
local function findRemotes()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SpawnNewTower" then SpawnTower = v
        elseif v.Name == "UpgradeTower" then UpgradeTower = v
        elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then SkipWave = v
        elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkip = v
        end
    end
end
findRemotes()

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false

-- // ИСПОЛЬЗУЕМ ТВОЙ СТАРЫЙ JSON
local SETTINGS_FILE = "macro_v27_final_fix.json"

local function saveAll()
    writefile(SETTINGS_FILE, HttpService:JSONEncode({
        autoReplay = autoReplay, autoPlay = autoPlay, currentSlot = currentSlot, macros = allMacros
    }))
end

local function loadAll()
    if isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok then
            autoReplay = data.autoReplay or false
            autoPlay = data.autoPlay or false
            currentSlot = data.currentSlot or 1
            allMacros = data.macros or {{}, {}, {}}
        end
    end
end
loadAll()

-- // ГРАФИКА
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "Macro_Fix_v27_3_Final"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 310) 
frame.Position = UDim2.new(0, 20, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.BackgroundTransparency = 1
status.Text = "Ready"

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(100, 100, 255) or Color3.fromRGB(45, 45, 45)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
    status.Text = "Slot " .. currentSlot .. (recording and " | REC" or "")
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 10)
    b.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function()
        if not recording and not playing then currentSlot = i updateUI() saveAll() end
    end)
end

local function makeBtn(txt, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,30)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(50,50,50)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    Instance.new("UICorner", b)
    return b
end

local recBtn = makeBtn("RECORD", 45, Color3.fromRGB(130,40,40))
local playBtn = makeBtn("PLAY", 85, Color3.fromRGB(40,130,40))
local arBtn = makeBtn("Auto Replay: OFF", 125)
local apBtn = makeBtn("Auto Play: OFF", 165)
local delBtn = makeBtn("CLEAR SLOT", 205, Color3.fromRGB(70,70,70))

local function refreshToggles()
    arBtn.Text = "Auto Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0,180,0) or Color3.fromRGB(50,50,50)
    apBtn.Text = "Auto Play: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0,180,0) or Color3.fromRGB(50,50,50)
    recBtn.Text = recording and "STOP & SAVE" or "RECORD"
end

-- // УЛУЧШЕННЫЙ КЛИКЕР PLAY AGAIN
local function clickPlayAgain()
    local found = false
    for _, v in pairs(lp.PlayerGui:GetDescendants()) do
        if v:IsA("TextButton") and v.Visible then
            local text = v.Text:lower()
            -- Проверяем текст кнопки или её имя
            if text:find("again") or text:find("retry") or text:find("replay") or v.Name:lower():find("retry") then
                pcall(function()
                    local pos = v.AbsolutePosition
                    local size = v.AbsoluteSize
                    -- Клик с небольшим офсетом (для мобилок)
                    VIM:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 55, 0, true, game, 1)
                    task.wait(0.1)
                    VIM:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 55, 0, false, game, 1)
                    found = true
                end)
            end
        end
    end
    return found
end

-- // ЗАПИСЬ
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if recording and not checkcaller() then
        local t = os.clock() - startTime
        if self == SpawnTower and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action = "spawn", id = tostring(args[1]), x = args[2].Position.X, y = args[2].Position.Y, z = args[2].Position.Z, t = t})
        elseif self == UpgradeTower then
            local tower = args[1]
            if tower and tower.PrimaryPart then
                table.insert(allMacros[currentSlot], {action = "upgrade", t = t, x = tower.PrimaryPart.Position.X, y = tower.PrimaryPart.Position.Y, z = tower.PrimaryPart.Position.Z})
            end
        elseif self == SkipWave or self == AutoSkip then
            table.insert(allMacros[currentSlot], {action = "skip", t = t, isAuto = (self == AutoSkip)})
        end
    end
    return old(self, ...)
end)

-- // ВОСПРОИЗВЕДЕНИЕ
local function findTower(x, y, z)
    local p = Vector3.new(x, y, z)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v.PrimaryPart and (v.PrimaryPart.Position - p).Magnitude < 2 then return v end
    end
end

local function runMacro()
    if #allMacros[currentSlot] == 0 or playing then return end
    playing = true
    local start = os.clock()
    task.spawn(function()
        for _, s in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock() - start) < s.t do task.wait() end
            task.wait(0.6) -- Задержка для прихода денег
            pcall(function()
                if s.action == "spawn" then SpawnTower:InvokeServer(s.id, CFrame.new(s.x, s.y, s.z))
                elseif s.action == "upgrade" then 
                    local tw = findTower(s.x, s.y, s.z)
                    if tw then UpgradeTower:InvokeServer(tw) end
                elseif s.action == "skip" then 
                    if s.isAuto then AutoSkip:FireServer() else SkipWave:InvokeServer() end 
                end
            end)
        end
        playing = false
        status.Text = "Finished! Waiting for Menu..."
        
        if autoReplay then
            while autoReplay do
                if clickPlayAgain() then 
                    status.Text = "Replay Clicked!"
                    break 
                end
                task.wait(2)
            end
        end
    end)
end

-- // КНОПКИ
recBtn.MouseButton1Click:Connect(function()
    if not recording then allMacros[currentSlot] = {} startTime = os.clock() recording = true else recording = false saveAll() end
    refreshToggles() updateUI()
end)

playBtn.MouseButton1Click:Connect(runMacro)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveAll() refreshToggles() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveAll() refreshToggles() end)
delBtn.MouseButton1Click:Connect(function() allMacros[currentSlot] = {} saveAll() updateUI() end)

loadAll() updateUI() refreshToggles()
if autoPlay then task.spawn(function() task.wait(10) runMacro() end) end
