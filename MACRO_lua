local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipWave, AutoSkip, RemoteReplay

-- ПОИСК REMOTES (Твой проверенный метод)
for _,v in ipairs(ReplicatedStorage:GetDescendants()) do
    if v.Name == "SpawnNewTower" or v.Name == "PlaceTower" then SpawnTower = v
    elseif v.Name == "UpgradeTower" then UpgradeTower = v
    elseif v.Name == "SkipWave" or v.Name == "VoteSkip" or v.Name == "Skip" then SkipWave = v
    elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkip = v
    elseif v.Name == "Replay" or v.Name == "PlayAgain" then RemoteReplay = v end
end

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

-- ФАЙЛЫ
local SETTINGS_FILE = "macro_settings_v15.json"

local function saveSettings()
    if writefile then 
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay, 
            autoPlay = autoPlay, 
            slot = currentSlot
        })) 
    end
end

local function loadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then 
            autoReplay = data.autoReplay or false 
            autoPlay = data.autoPlay or false 
            currentSlot = data.slot or 1 
        end
    end
end

local function forceClick(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 1)
    end)
end

--================ GUI ================--
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_V15_Persistent"
ui.ResetOnSpawn = false

local main = Instance.new("Frame", ui)
main.Size = UDim2.new(0, 160, 0, 260)
main.Position = UDim2.new(0, 20, 0.5, -130)
main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
main.Active, main.Draggable = true, true
Instance.new("UICorner", main)

local function btn(txt, y, h, color)
    local b = Instance.new("TextButton", main)
    b.Size, b.Position = UDim2.new(1, -14, 0, h), UDim2.new(0, 7, 0, y)
    b.Text, b.BackgroundColor3 = txt, color or Color3.fromRGB(40, 40, 40)
    b.TextColor3, b.Font, b.TextSize = Color3.new(1,1,1), Enum.Font.GothamBold, 11
    Instance.new("UICorner", b)
    return b
end

local slotBtn = btn("SLOT: "..currentSlot, 10, 30)
local recBtn = btn("START RECORD", 45, 40, Color3.fromRGB(80, 30, 30))
local playBtn = btn("PLAY MACRO", 90, 40, Color3.fromRGB(30, 80, 30))
local arBtn = btn("REPLAY: OFF", 135, 30)
local apBtn = btn("AUTO PLAY: OFF", 170, 30)
local delBtn = btn("DELETE DATA", 215, 30, Color3.fromRGB(120, 20, 20))

local function updateUI()
    slotBtn.Text = "SLOT: "..currentSlot.." ("..#allMacros[currentSlot]..")"
    arBtn.Text = "REPLAY: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40, 40, 40)
    apBtn.Text = "AUTO PLAY: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40, 40, 40)
    recBtn.Text = recording and "STOP & SAVE" or "START RECORD"
    recBtn.BackgroundColor3 = recording and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(80, 30, 30)
end

--================ ЛОГИКА КНОПОК ================--
slotBtn.MouseButton1Click:Connect(function()
    if not recording then 
        currentSlot = (currentSlot % SLOTS) + 1 
        saveSettings() 
        updateUI() 
    end
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot], placed = {}, {}
        startTime, recording = os.clock(), true
    else
        recording = false
        if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    end
    updateUI()
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if isfile and isfile("macro_s"..currentSlot..".json") then delfile("macro_s"..currentSlot..".json") end
    updateUI()
end)

arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveSettings() updateUI() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveSettings() updateUI() end)

-- ОТСЛЕЖИВАНИЕ REJOIN (Play Again)
RunService.Heartbeat:Connect(function()
    if recording then
        local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
        if rb and rb.Visible then
            local conn; conn = rb.MouseButton1Click:Connect(function()
                if recording then
                    table.insert(allMacros[currentSlot], {action="rejoin", t=os.clock()-startTime})
                    recording = false
                    writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot]))
                    updateUI()
                end
                conn:Disconnect()
            end)
        end
    end
end)

--================ ХУКИ ЗАПИСИ (Твой оригинал + фикс апгрейда) ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local result = old(self, ...)
            local index = #placed + 1
            placed[index] = result -- Запоминаем объект
            local cf = args[2]
            table.insert(allMacros[currentSlot], {
                action = "spawn", index = index, id = tostring(args[1]),
                x = cf.Position.X, y = cf.Position.Y, z = cf.Position.Z, t = os.clock() - startTime
            })
            return result
        elseif self == UpgradeTower and method == "InvokeServer" then
            local tower = args[1]
            for i = #placed, 1, -1 do
                if placed[i] == tower then
                    table.insert(allMacros[currentSlot], {action = "upgrade", index = i, t = os.clock() - startTime})
                    break
                end
            end
        elseif SkipWave and self == SkipWave and (method == "InvokeServer" or method == "FireServer") then
            table.insert(allMacros[currentSlot], {action = "skip", t = os.clock() - startTime})
        end
    end
    return old(self, ...)
end)

--================ ПЛЕЕР ================--
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    
    task.spawn(function()
        local built = {}
        local begin = os.clock()
        local steps = allMacros[currentSlot]

        for _, step in ipairs(steps) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end

            if step.action == "spawn" then
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok then built[step.index] = tower end
            elseif step.action == "upgrade" then
                local tower = built[step.index]
                if tower then
                    -- ФИКС: Обновляем ссылку после апгрейда, чтобы качало дальше
                    local ok, newTower = pcall(function() return UpgradeTower:InvokeServer(tower) end)
                    if ok and typeof(newTower) == "Instance" then
                        built[step.index] = newTower
                    else
                        -- Если сервер не вернул объект, ищем по позиции (мини-фикс)
                        task.wait(0.1)
                        for _, v in pairs(game.Workspace.Towers:GetChildren()) do
                            if v.PrimaryPart and (v.PrimaryPart.Position - Vector3.new(step.x, step.y, step.z)).Magnitude < 1 then
                                built[step.index] = v break
                            end
                        end
                    end
                end
            elseif step.action == "rejoin" then
                local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
                forceClick(rb)
            end
        end
        playing = false
    end)
end

playBtn.MouseButton1Click:Connect(doPlay)

-- ИНИЦИАЛИЗАЦИЯ
loadSettings()
for i=1, SLOTS do 
    pcall(function() 
        if isfile and isfile("macro_s"..i..".json") then 
            allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) 
        end 
    end) 
end
updateUI()

-- АВТО-СТАРТ ПРИ ЗАХОДЕ
if autoPlay then 
    task.spawn(function()
        task.wait(5)
        doPlay()
    end)
end

-- АВТО-РЕПЛЕЙ (Если не записано в макросе)
task.spawn(function()
    while task.wait(3) do
        if autoReplay and not recording and not playing then
            local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
            if rb and rb.Visible then forceClick(rb) end
        end
    end
end)
