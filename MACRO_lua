gui.Name = "Macro_V28_2"
gui.ResetOnSpawn = false
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 330) 
frame.Position = UDim2.new(0, 20, 0.5, -165)
frame.BackgroundColor3 = Color3.fromRGB(15,15,15)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

-- ВЕРСИЯ СВЕРХУ
local vLabel = Instance.new("TextLabel", frame)
vLabel.Size = UDim2.new(1,0,0,15)
vLabel.Position = UDim2.new(0,0,0,2)
vLabel.Text = "VERSION v28.2"
vLabel.TextColor3 = Color3.fromRGB(100,100,100)
vLabel.TextSize = 10
vLabel.BackgroundTransparency = 1

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.BackgroundTransparency = 1
status.Text = "Ready"

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(124, 106, 255) or Color3.fromRGB(35, 35, 35)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
    status.Text = "Slot " .. currentSlot .. (playing and " | PLAYING" or (recording and " | REC" or ""))
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 20)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function()
        if not recording and not playing then currentSlot = i updateUI() saveAll() end
    end)
end

local function makeBtn(txt, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,30)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    Instance.new("UICorner", b)
    return b
end

local recBtn = makeBtn("RECORD", 55, Color3.fromRGB(150,40,40))
local playBtn = makeBtn("PLAY", 95, Color3.fromRGB(40,150,40))
local arBtn = makeBtn("Auto Replay: OFF", 135)
local apBtn = makeBtn("Auto Play: OFF", 175)
local delBtn = makeBtn("CLEAR SLOT", 215)

local function refreshToggles()
    arBtn.Text = "Auto Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(0,150,0) or Color3.fromRGB(40,40,40)
    apBtn.Text = "Auto Play: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(0,150,0) or Color3.fromRGB(40,40,40)
    updateUI()
end

local function forceClick(v)
    if not v then return end
    pcall(function()
        local pos = v.AbsolutePosition
        local sz = v.AbsoluteSize
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2 + 55, 0, true, game, 1)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(pos.X + sz.X/2, pos.Y + sz.Y/2 + 55, 0, false, game, 1)
        for _, c in ipairs(getconnections(v.MouseButton1Click)) do c:Fire() end
    end)
end

-- // ПЛЕЕР
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    updateUI()
    
    task.spawn(function()
        local built = {}
        local begin = os.clock()
        findRemotes()

        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end

            if step.action == "spawn" then
                repeat
                    local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                    if ok and tower then built[step.index] = tower break end
                    status.Text = "CASH WAIT: SPAWN"
                    task.wait(0.5)
                until not playing
            elseif step.action == "upgrade" then
                repeat
                    local tw = built[step.index]
                    if tw then 
                        local ok, res = pcall(function() return UpgradeTower:InvokeServer(tw) end)
                        if ok and res ~= false then break end
                    end
                    status.Text = "CASH WAIT: UPGRADE"
                    task.wait(0.5)
                until not playing
            elseif step.action == "skip" or step.action == "autoskip" then
                pcall(function() 
                    local rem = (step.action == "skip") and SkipWave or AutoSkip
                    if rem:IsA("RemoteFunction") then rem:InvokeServer(step.value) else rem:FireServer(step.value) end 
                end)
            elseif step.action == "click" then
                task.wait(1)
                for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                    if v:IsA("TextButton") and v.Visible and (v.Text:lower():find("again") or v.Name:lower():find("retry")) then
                        forceClick(v)
                    end
                end
            end
        end
        playing = false
        updateUI()
    end)
end

-- // ЦИКЛ AUTO PLAY И AUTO REPLAY
task.spawn(function()
    while task.wait(3) do
        -- AUTO REPLAY (Play Again)
        if autoReplay and not playing and not recording then
            for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") and v.Visible and (v.Text:lower():find("again") or v.Name:lower():find("retry")) then
                    forceClick(v)
                    task.wait(5)
                end
            end
        end
        -- AUTO PLAY (Старт макроса)
        if autoPlay and not playing and not recording and #allMacros[currentSlot] > 0 then
            findRemotes()
            if SpawnTower then 
                status.Text = "AUTO-STARTING..."
                doPlay() 
            end
        end
    end
end)

-- // ХУК ЗАПИСИ
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    if recording and not checkcaller() then
        local t = os.clock() - startTime
        if self == SpawnTower then
            local res = old(self, ...)
            table.insert(allMacros[currentSlot], {action="spawn", index=#allMacros[currentSlot]+1, id=tostring(args[1]), x=args[2].Position.X, y=args[2].Position.Y, z=args[2].Position.Z, t=t})
            return res
        elseif self == UpgradeTower then
            local tower = args[1]
            if tower and tower.PrimaryPart then
                for i, step in ipairs(allMacros[currentSlot]) do
                    if step.action == "spawn" and (Vector3.new(step.x, step.y, step.z) - tower.PrimaryPart.Position).Magnitude < 2 then
                        table.insert(allMacros[currentSlot], {action="upgrade", index=step.index, t=t})
                        break
                    end
                end
            end
        elseif self == SkipWave or self == AutoSkip then
            table.insert(allMacros[currentSlot], {action=(self==AutoSkip and "autoskip" or "skip"), value=args[1], t=t})
        end
    end
    return old(self, ...)
end)

local oldGui; oldGui = hookmetamethod(game, "__index", function(self, key)
    if recording and key == "MouseButton1Click" and self:IsA("TextButton") then
        local t = os.clock() - startTime
        if self.Text:lower():find("again") or self.Text:lower():find("retry") then
            table.insert(allMacros[currentSlot], {action="click", t=t})
        end
    end
    return oldGui(self, key)
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then allMacros[currentSlot] = {} startTime = os.clock() recording = true else recording = false saveAll() end
    updateUI()
end)
playBtn.MouseButton1Click:Connect(doPlay)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveAll() refreshToggles() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveAll() refreshToggles() end)
delBtn.MouseButton1Click:Connect(function() allMacros[currentSlot] = {} saveAll() updateUI() end)

refreshToggles()
