        slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(80,80,200) or Color3.fromRGB(40,40,40)
        slotBtns[i].Text = "S"..i.." ("..#allMacros[i]..")"
    end
end

