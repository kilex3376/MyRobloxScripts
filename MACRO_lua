local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local userInput = game:GetService("UserInputService")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipWave, AutoSkip, MoneyValue, RemoteReplay

-- 1. ПОИСК REMOTES (В отдельном потоке, чтобы точно найти)
task.spawn(function()
    while not SpawnTower or not UpgradeTower or not SkipWave do
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" or v.Name == "PlaceTower" then
                SpawnTower = v

            elseif v.Name == "UpgradeTower" then
                UpgradeTower = v

            elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then
                SkipWave = v

            elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then
                AutoSkip = v
            end
        end

        pcall(function()
            MoneyValue = Players.LocalPlayer
                :WaitForChild("PlayerGui")
                :WaitForChild("HUD")
                :WaitForChild("Main")
                :WaitForChild("Top")
                :WaitForChild("Cash")
        end)

        task.wait(1)
    end
end) 
local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

-- ЗАГРУЗКА/СОХРАНЕНИЕ
local SETTINGS_FILE = "macro_settings_v19.json"
local function saveSettings()
    if writefile then writefile(SETTINGS_FILE, HttpService:JSONEncode({autoReplay = autoReplay, autoPlay = autoPlay, slot = currentSlot})) end
end
local function loadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then autoReplay = data.autoReplay; autoPlay = data.autoPlay; currentSlot = data.slot or 1 end
    end
end

-- КЛИК БЕЗ БАГА МЫШИ
local function forceClick(btn)
    if not btn then return end
    pcall(function()
        for _, connection in ipairs(getconnections(btn.MouseButton1Click)) do connection:Fire() end
        for _, connection in ipairs(getconnections(btn.Activated)) do connection:Fire() end
    end)
    GuiService.SelectedObject = nil
end

