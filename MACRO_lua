local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local VIM = game:GetService("VirtualInputManager")

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false
local SETTINGS_FILE = "macro_v29_5.json"

-- // ГУИ (Версия 29.5)
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "Macro_V29_5"
gui.ResetOnSpawn = false
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 340) 
frame.Position = UDim2.new(0, 20, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.Text = "READY"
status.BackgroundTransparency = 1

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(35, 35, 35)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 25)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function() currentSlot = i updateUI() end)
end

local function makeBtn(txt, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,32)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(45,45,45)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    Instance.new("UICorner", b)
    return b
end

local recBtn = makeBtn("RECORD", 60, Color3.fromRGB(150,0,0))
local playBtn = makeBtn("PLAY", 100, Color3.fromRGB(0,130,0))
local arBtn = makeBtn("Auto Replay: OFF", 140)
local apBtn = makeBtn("Auto Play: OFF", 180)
local delBtn = makeBtn("CLEAR SLOT", 220)

-- // ТВОЯ ЛОГИКА ЗАПИСИ КНОПКИ
task.spawn(function()
    while true do
        task.wait(1)
        if recording then
            for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") and v.Visible and (v.Text:lower():find("again") or v.Name:lower():find("Retry")) then
                    local connection
                    connection = v.MouseButton1Click:Connect(function()
                        if recording then
                            table.insert(allMacros[currentSlot], {action="replay_click", t=os.clock()-startTime})
                            status.Text = "REPLAY RECORDED!"
                            recording = false
                            updateUI()
                        end
                        connection:Disconnect()
                    end)
                    repeat task.wait(1) until not v.Visible or not recording
                    if connection then connection:Disconnect() end
                end
            end
        end
    end
end)

-- // ПЕРЕХВАТ ДЕЙСТВИЙ (СПАВН И АПГРЕЙД)
local oldNC; oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    if recording and not checkcaller() then
        local t = os.clock() - startTime
        if typeof(args[2]) == "CFrame" or typeof(args[2]) == "Vector3" then
            table.insert(allMacros[currentSlot], {action="spawn", remote=self, id=args[1], pos=args[2], t=t})
            task.spawn(updateUI)
        elseif typeof(args[1]) == "Instance" and not args[2] then
            table.insert(allMacros[currentSlot], {action="upgrade", remote=self, obj=args[1], t=t})
            task.spawn(updateUI)
        end
    end
    return oldNC(self, ...)
end)

-- // ПЛЕЕР
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local start = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock() - start) < step.t do task.wait() end
            pcall(function()
                if step.action == "spawn" then step.remote:InvokeServer(step.id, step.pos)
                elseif step.action == "upgrade" then step.remote:InvokeServer(step.obj)
                elseif step.action == "replay_click" then
                    for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                        if v:IsA("TextButton") and v.Visible and v.Text:lower():find("again") then
                            for _, c in ipairs(getconnections(v.MouseButton1Click)) do c:Fire() end
                        end
                    end
                end
            end)
        end
        playing = false
        status.Text = "DONE"
    end)
end

-- // АВТО-РЕПЛЕЙ И АВТО-СТАРТ
task.spawn(function()
    while task.wait(3) do
        if autoReplay and not playing and not recording then
            for _, v in pairs(lp.PlayerGui:GetDescendants()) do
                if v:IsA("TextButton") and v.Visible and v.Text:lower():find("again") then
                    for _, c in ipairs(getconnections(v.MouseButton1Click)) do c:Fire() end
                end
            end
        end
        if autoPlay and not playing and #allMacros[currentSlot] > 0 then
            if workspace:FindFirstChild("Towers") or workspace:FindFirstChild("Map") then doPlay() end
        end
    end
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then allMacros[currentSlot] = {} startTime = os.clock() recording = true status.Text = "RECORDING..."
    else recording = false status.Text = "SAVED" end
    updateUI()
end)

playBtn.MouseButton1Click:Connect(doPlay)
arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay arBtn.Text = "Auto Replay: "..(autoReplay and "ON" or "OFF") end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay apBtn.Text = "Auto Play: "..(autoPlay and "ON" or "OFF") end)
delBtn.MouseButton1Click:Connect(function() allMacros[currentSlot] = {} updateUI() end)
updateUI()
