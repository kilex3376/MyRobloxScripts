local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

if not game:IsLoaded() then game.Loaded:Wait() end
local lp = Players.LocalPlayer or Players.PlayerAdded:Wait()

local SpawnTower, UpgradeTower, MoneyValue
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false

local SETTINGS_FILE = "macro_settings.json"

-- ЛОГИКА ФАЙЛОВ
local function saveMacro(slot)
    if writefile then
        writefile("macro_s"..slot..".json", HttpService:JSONEncode(allMacros[slot]))
    end
end

local function loadSettings()
    if readfile and isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then
            autoReplay, autoPlay, currentSlot = data.autoReplay or false, data.autoPlay or false, data.lastSlot or 1
        end
    end
    for i = 1, 3 do
        local name = "macro_s"..i..".json"
        if isfile and isfile(name) then
            allMacros[i] = HttpService:JSONDecode(readfile(name))
        end
    end
end

-- ПОИСК ИВЕНТОВ (Исправлено под продажу)
task.spawn(function()
    while not SpawnTower do
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" or v.Name == "PlaceTower" then SpawnTower = v
            elseif v.Name == "UpgradeTower" or v.Name == "UpgradeUnit" or v.Name == "SellTower" then UpgradeTower = v end
        end
        task.wait(0.5)
    end
end)

-- ИНТЕРФЕЙС (Тот самый компактный)
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_Ultimate"
ui.ResetOnSpawn = false

local function createFrame(name, pos, size, color)
    local f = Instance.new("Frame", ui)
    f.Position, f.Size = pos, size
    f.BackgroundColor3 = color
    f.BackgroundTransparency = 0.2
    f.Active, f.Draggable = true, true
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6)
    return f
end

local main = createFrame("Main", UDim2.new(0, 50, 0.5, -80), UDim2.new(0, 160, 0, 180), Color3.fromRGB(30, 30, 30))
local settings = createFrame("Settings", UDim2.new(0, 220, 0.5, -80), UDim2.new(0, 160, 0, 180), Color3.fromRGB(20, 20, 20))

local function createBtn(txt, parent, pos, size, color)
    local b = Instance.new("TextButton", parent)
    b.Position, b.Size = pos, size or UDim2.new(1, -14, 0, 28)
    b.BackgroundColor3 = color or Color3.fromRGB(50, 50, 50)
    b.Text, b.TextColor3 = txt, Color3.new(1,1,1)
    b.Font, b.TextSize = Enum.Font.SourceSansBold, 13
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    return b
end

local status = Instance.new("TextLabel", main)
status.Size, status.Position = UDim2.new(1, 0, 0, 15), UDim2.new(0, 0, 1, -18)
status.Text, status.TextColor3, status.BackgroundTransparency = "READY", Color3.new(0.7,0.7,0.7), 1
status.TextSize = 10

-- ВОСПРОИЗВЕДЕНИЕ (С поддержкой продажи и апгрейда)
local function startPlay()
    local macro = allMacros[currentSlot]
    if playing or #macro == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local begin = os.clock()
        for _, step in ipairs(macro) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    SpawnTower:InvokeServer(step.id, CFrame.new(unpack(step.cf)))
                elseif step.action == "upgrade" then
                    -- Ищем юнита по позиции, так как ID меняется при перезаходе
                    for _, unit in ipairs(workspace.Towers:GetChildren()) do
                        if (unit.PrimaryPart.Position - Vector3.new(unpack(step.pos))).Magnitude < 1 then
                            UpgradeTower:InvokeServer(unit, step.type)
                            break
                        end
                    end
                end
            end)
        end
        playing, status.Text = false, "FINISHED"
    end)
end

-- ЗАПИСЬ (Хук на все действия)
recBtn = createBtn("RECORD", main, UDim2.new(0, 7, 0, 45))
recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    allMacros[currentSlot] = {}
    startTime, recording = os.clock(), true
    status.Text = "RECORDING..."
    
    local old; old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if recording and method == "InvokeServer" then
            if self == SpawnTower then
                table.insert(allMacros[currentSlot], {
                    action = "spawn", 
                    id = args[1], 
                    cf = {args[2].X, args[2].Y, args[2].Z}, 
                    t = os.clock() - startTime
                })
            elseif self == UpgradeTower then
                -- Запоминаем позицию юнита, чтобы найти его потом
                local unitPos = args[1].PrimaryPart.Position
                table.insert(allMacros[currentSlot], {
                    action = "upgrade", 
                    pos = {unitPos.X, unitPos.Y, unitPos.Z}, 
                    type = args[2], -- "Upgrade" или "Sell"
                    t = os.clock() - startTime
                })
            end
        end
        return old(self, ...)
    end)
end)

-- ОСТАЛЬНЫЕ КНОПКИ
createBtn("STOP", main, UDim2.new(0, 7, 0, 80)).MouseButton1Click:Connect(function()
    recording = false
    status.Text = "SAVED"
    saveMacro(currentSlot)
end)

createBtn("PLAY", main, UDim2.new(0, 7, 0, 115), nil, Color3.fromRGB(40, 60, 120)).MouseButton1Click:Connect(startPlay)

loadSettings()
status.Text = "SLOT " .. currentSlot
