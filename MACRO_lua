-- ФУНКЦИЯ ИГРЫ
local function startPlay()
    if playing or #macro == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local begin = os.clock()
        for _, step in ipairs(macro) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end
            pcall(function() SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
        end
        playing = false
        status.Text = "FINISHED"
        if autoReplay then setReplayFlag(currentSlot) end
    end)
end

-- ЗАПИСЬ (HOOK)
recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    macro = {}
    allMacros[currentSlot] = macro
    startTime = os.clock()
    recording = true
    status.Text = "RECORDING..."
    
    local old; old = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if method == "InvokeServer" and self == SpawnTower and recording then
            table.insert(macro, {
                action = "spawn",
                id = args[1],
                x = args[2].X, y = args[2].Y, z = args[2].Z,
                t = os.clock() - startTime
            })
        end
        return old(self, ...)
    end)
end)

