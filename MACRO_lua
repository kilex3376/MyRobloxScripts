local pc2=nil
local function pulse()local t=0 pc2=RS.Heartbeat:Connect(function(dt)t+=dt local a=(math.sin(t*4)+1)/2 recStk.Color=Color3.fromRGB(239,math.floor(68*a),math.floor(68*a))end)end
local function unpulse()if pc2 then pc2:Disconnect()pc2=nil end recStk.Color=Color3.fromRGB(239,68,68)end
local old old=hookmetamethod(game,"__namecall",function(self,...)
	local args,m={...},getnamecallmethod()
	if not checkcaller()and rec then
		local nm=tostring(self)
		if nm=="SpawnNewTower"and m=="InvokeServer"then
			local ok,res=pcall(old,self,...)if not ok then return end
			local cf=args[2]if typeof(cf)~="CFrame"then return res end
			local idx=#placed+1 placed[idx]=res
			table.insert(slots[cur].steps,{action="spawn",towerIndex=idx,unitUUID=tostring(args[1]),time=tick()-t0,pos={x=cf.X,y=cf.Y,z=cf.Z}})
			upd()log("Spawn #"..idx,Color3.fromRGB(34,197,94))return res
		end
		if nm=="UpgradeTower"and m=="InvokeServer"then
			local tw2=args[1]for i,v in pairs(placed)do if v==tw2 then
				table.insert(slots[cur].steps,{action="upgrade",towerIndex=i,time=tick()-t0})
				upd()log("Upgrade #"..i,Color3.fromRGB(234,179,8))break
			end end
		end
	end
	return old(self,...)
end)
recBtn.MouseButton1Click:Connect(function()
	if play then log("Stop playback first!",Color3.fromRGB(239,68,68))return end
	rec=true slots[cur].steps={} placed={} t0=tick() pulse()upd()
	log("Recording "..cur.."...",Color3.fromRGB(239,68,68))tw(recBtn,{BackgroundColor3=Color3.fromRGB(80,30,30)})
end)
stpBtn.MouseButton1Click:Connect(function()
	if not rec then return end rec=false unpulse()
	log("Stopped - "..#slots[cur].steps.." steps",Color3.fromRGB(234,179,8))
	tw(recBtn,{BackgroundColor3=Color3.fromRGB(32,32,48)})
end)
savBtn.MouseButton1Click:Connect(function()
	if#slots[cur].steps==0 then log("Nothing to save!",Color3.fromRGB(239,68,68))return end
	save(cur)log("Saved slot "..cur,Color3.fromRGB(34,197,94))
end)
lodBtn.MouseButton1Click:Connect(function()
	local f="ms"..cur..".json"
	if not isfile(f)then log("No save for slot "..cur,Color3.fromRGB(239,68,68))return end
	local ok,d=pcall(function()return HS:JSONDecode(readfile(f))end)
	if ok and d then slots[cur].name=d.name or"Macro "..cur slots[cur].steps=d.steps or{} ref()upd()log("Loaded "..#slots[cur].steps.." steps",Color3.fromRGB(59,130,246))
	else log("Load failed!",Color3.fromRGB(239,68,68))end
end)
plyBtn.MouseButton1Click:Connect(function()
	if play then log("Already playing!",Color3.fromRGB(239,68,68))return end
	if rec then log("Stop recording first!",Color3.fromRGB(239,68,68))return end
	local steps=slots[cur].steps
	if#steps==0 then log("Empty!",Color3.fromRGB(239,68,68))return end
	if not ST or not UT then log("Remotes not ready!",Color3.fromRGB(239,68,68))return end
	play=true tw(plyBtn,{BackgroundColor3=Color3.fromRGB(40,40,80)})plyStk.Color=Color3.fromRGB(99,102,241)
	task.spawn(function()
		local cr,err,ps={},0,os.clock()
		for i,s in ipairs(steps)do
			if not play then break end
			local tgt=ps+(s.time/spd)
			local rw=tgt-os.clock()-.05 if rw>0 then task.wait(rw)end
			while os.clock()<tgt do RS.Heartbeat:Wait()end
			log(string.format("[%d/%d] %s",i,#steps,s.action),Color3.fromRGB(99,102,241))
			if s.action=="spawn"then
				local ok,res=inv(ST,3,s.unitUUID,CFrame.new(s.pos.x,s.pos.y,s.pos.z))
				if ok then cr[s.towerIndex]=res else err+=1 warn("Spawn fail "..i)end
			elseif s.action=="upgrade"then
				local tw2=cr[s.towerIndex]
				if tw2 then local ok2=inv(UT,5,tw2)if not ok2 then err+=1 warn("Upg fail "..i)end
				else err+=1 warn("No tower "..i)end
			end
		end
		play=false tw(plyBtn,{BackgroundColor3=Color3.fromRGB(32,32,48)})plyStk.Color=Color3.fromRGB(60,60,90)
		log(err>0 and"Done - "..err.." err(s)"or"Done!",err>0 and Color3.fromRGB(234,179,8)or Color3.fromRGB(34,197,94))
	end)
end)
