local function tw(o,p,d)TS:Create(o,TweenInfo.new(d or.15,Enum.EasingStyle.Quad),p):Play()end
local function log(m,c)if sl then sl.Text=m sl.TextColor3=c or Color3.fromRGB(200,200,255)end print("[M]"..m)end
local function save(i)if writefile then pcall(function()writefile("ms"..i..".json",HS:JSONEncode({name=slots[i].name,steps=slots[i].steps}))end)end end
local function inv(r,n,...)local a={...}for k=1,n do local ok,res=pcall(function()return r:InvokeServer(table.unpack(a))end)if ok then return true,res end task.wait(.15*k)end return false,nil end
