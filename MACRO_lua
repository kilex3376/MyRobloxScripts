end)

local function clickButton(btn)
    if not btn then return false end

    local success = false

    success = pcall(function()
        if firesignal and btn.MouseButton1Click then
            firesignal(btn.MouseButton1Click)
        end
    end)

    if success then
        return true
    end

    success = pcall(function()
        if btn.Activated then
            firesignal(btn.Activated)
        end
    end)

    if success then
        return true
    end

    success = pcall(function()
        local absPos = btn.AbsolutePosition
        local absSize = btn.AbsoluteSize
        local x = absPos.X + absSize.X / 2
        local y = absPos.Y + absSize.Y / 2

        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)

    return success
end

local function waitAndClickPlayAgain(timeout)
    local gui = Players.LocalPlayer:WaitForChild("PlayerGui")
    local started = tick()

    while tick() - started < timeout do
        local endScreen = gui:FindFirstChild("GameGui")
        if endScreen then
            endScreen = endScreen:FindFirstChild("EndScreen")
        end

        local replay = endScreen and endScreen:FindFirstChild("Replay")

        if replay and replay.Visible then
            print("[Macro] Direct replay button found:", replay:GetFullName())

            pcall(function()
                if replay:IsA("TextButton") or replay:IsA("ImageButton") then
                    replay:Activate()
                end
            end)

            pcall(function()
                if firesignal then
                    if replay.MouseButton1Down then
                        firesignal(replay.MouseButton1Down)
                    end
                    if replay.MouseButton1Click then
                        firesignal(replay.MouseButton1Click)
                    end
                    if replay.Activated then
                        firesignal(replay.Activated)
                    end
                end
            end)

            task.wait(0.2)

            pcall(function()
                local pos = replay.AbsolutePosition
                local size = replay.AbsoluteSize

                local x = pos.X + size.X / 2
                local y = pos.Y + size.Y / 2

                VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                task.wait()
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end)

            task.wait(1)

            local stillHere = Players.LocalPlayer.PlayerGui:FindFirstChild("GameGui")
            if stillHere and stillHere:FindFirstChild("EndScreen") then
                warn("[Macro] Replay button did not actually teleport, forcing rejoin")

                local TeleportService = game:GetService("TeleportService")
                TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
            end

            return true
        end

        task.wait(0.25)
    end

    warn("[Macro] Replay button not found at GameGui.EndScreen.Replay")
    return false
end

