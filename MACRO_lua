local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- Прямые ссылки (вернул старый формат, раз он работал)
local GameFolder = ReplicatedStorage:WaitForChild("Game")
local Functions = GameFolder:WaitForChild("Functions")
local Events = GameFolder:WaitForChild("Events")

local PlaceTower = Functions:WaitForChild("PlaceTower")
local UpgradeTower = Functions:WaitForChild("UpgradeTower")
local RemoteReplay = Events:WaitForChild("Replay")

local steps = {}
local built = {}
local recording = false
local playing = false
local autoPlay = false
local autoReplay = false
local startTime = 0

--================ GUI (ВОЗВРАЩЕН ПОЛНОСТЬЮ) ================--
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "CursedMacro_FinalFix"
ui.ResetOnSpawn = false

local main = Instance.new("Frame", ui)
main.Size = UDim2.new(0, 200, 0, 300) -- Увеличил размер под все кнопки
main.Position = UDim2.new(0.1, 0, 0.5, -150)
main.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
main.Active, main.Draggable = true, true
Instance.new("UICorner", main)

local function createBtn(text, pos, color)
    local b = Instance.new("TextButton", main)
    b.Text = text
    b.Size = UDim2.new(1, -20, 0, 35)
    b.Position = pos
    b.BackgroundColor3 = color
    b.TextColor3 = Color3.new(1, 1, 1)
    Instance.new("UICorner", b)
    return b
end

local recBtn = createBtn("RECORD", UDim2.new(0, 10, 0, 10), Color3.fromRGB(150, 40, 40))
local playBtn = createBtn("PLAY (MANUAL)", UDim2.new(0, 10, 0, 50), Color3.fromRGB(40, 120, 40))
local autoPlayBtn = createBtn("AUTO PLAY: OFF", UDim2.new(0, 10, 0, 90), Color3.fromRGB(60, 60, 60))
local replayBtn = createBtn("AUTO REPLAY: OFF", UDim2.new(0, 10, 0, 130), Color3.fromRGB(60, 60, 60))

local status = Instance.new("TextLabel", main)
status.Size = UDim2.new(1, 0, 0, 30)
status.Position = UDim2.new(0, 0, 0, 260)
status.Text = "Status: Ready"
status.TextColor3 = Color3.new(1,1,1)
status.BackgroundTransparency = 1

--================ ЛОГИКА ЗАПИСИ (СТАРАЯ) ================--
PlaceTower.OnClientInvoke = function(name, pos, rotation)
    if recording then
        table.insert(steps, {
            time = tick() - startTime,
            action = "place",
            name = name,
            pos = pos,
            rot = rotation
        })
    end
end

UpgradeTower.OnClientInvoke = function(tower)
    if recording then
        local foundIndex = nil
        for i, t in pairs(built) do
            if t == tower then foundIndex = i break end
        end
        table.insert(steps, {
            time = tick() - startTime,
            action = "upgrade",
            index = foundIndex or #built
        })
    end
end

--================ ФУНКЦИЯ ВОСПРОИЗВЕДЕНИЯ ================--
local function startPlaying()
    if playing then return end
    playing = true
    status.Text = "Playing..."
    built = {}
    local playStart = tick()
    local stepIdx = 1

    while playing and stepIdx <= #steps do
        local step = steps[stepIdx]
        if tick() - playStart >= step.time then
            if step.action == "place" then
                local ok, tower = pcall(function() return PlaceTower:InvokeServer(step.name, step.pos, step.rot) end)
                if ok and tower then table.insert(built, tower) end
            
            elseif step.action == "upgrade" then
                local tower = built[step.index]
                if tower then
                    local oldPos = tower.PrimaryPart and tower.PrimaryPart.Position
                    -- ФИКС ТУТ: Обновляем ссылку на новую башню после апгрейда
                    local ok, newTower = pcall(function() return UpgradeTower:InvokeServer(tower) end)
                    if ok and typeof(newTower) == "Instance" then
                        built[step.index] = newTower
                    elseif oldPos then
                        task.wait(0.2)
                        for _, v in pairs(game.Workspace.Towers:GetChildren()) do
                            if v.PrimaryPart and (v.PrimaryPart.Position - oldPos).Magnitude < 1 then
                                built[step.index] = v break
                            end
                        end
                    end
                end
            end
            stepIdx = stepIdx + 1
        end
        task.wait(0.05)
    end
    playing = false
    status.Text = "Done"
end

--================ ОБРАБОТКА КНОПОК ================--
recBtn.MouseButton1Click:Connect(function()
    recording = not recording
    if recording then
        steps = {}; built = {}; startTime = tick()
        recBtn.Text = "STOP RECORDING"; status.Text = "Recording..."
    else
        recBtn.Text = "RECORD"; status.Text = "Saved: " .. #steps
    end
end)

playBtn.MouseButton1Click:Connect(startPlaying)

autoPlayBtn.MouseButton1Click:Connect(function()
    autoPlay = not autoPlay
    autoPlayBtn.Text = autoPlay and "AUTO PLAY: ON" or "AUTO PLAY: OFF"
    autoPlayBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(60, 60, 60)
end)

replayBtn.MouseButton1Click:Connect(function()
    autoReplay = not autoReplay
    replayBtn.Text = autoReplay and "AUTO REPLAY: ON" or "AUTO REPLAY: OFF"
    replayBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(60, 60, 60)
end)

--================ АВТО-ЦИКЛ (PLAY И REPLAY) ================--
task.spawn(function()
    while task.wait(2) do
        -- Авто-старт при начале раунда
        if autoPlay and not playing and #steps > 0 then
            local timer = game.Workspace:FindFirstChild("Timer") -- Проверка, что игра началась
            if timer or #game.Workspace.Towers:GetChildren() >= 0 then
                startPlaying()
            end
        end
        
        -- Авто-реплей при конце
        if autoReplay then
            local victory = lp.PlayerGui:FindFirstChild("VictoryGui")
            local defeat = lp.PlayerGui:FindFirstChild("DefeatGui")
            if (victory and victory.Enabled) or (defeat and defeat.Enabled) then
                RemoteReplay:FireServer()
                task.wait(5)
            end
        end
    end
end)
