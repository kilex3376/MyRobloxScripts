local dragging = false
knob.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local rel = math.clamp((i.Position.X - slider.AbsolutePosition.X) / slider.AbsoluteSize.X,0,1)
        fill.Size = UDim2.new(rel,0,1,0)
        knob.Position = UDim2.new(rel,-7,0.5,-7)
        playbackSpeed = math.floor((0.25 + rel * 2.75) * 100) / 100
        speedText.Text = "Speed: " .. string.format("%.2f", playbackSpeed) .. "x"
    end
end)

local old
old = hookmetamethod(game,"__namecall",function(self,...)
    local args = {...}
    local method = getnamecallmethod()

    if not checkcaller() and recording then
        if tostring(self) == "SpawnNewTower" and method == "InvokeServer" then
            local ok,result = pcall(old,self,...)
            if ok and typeof(args[2]) == "CFrame" then
                local idx = #placed + 1
                placed[idx] = result

                table.insert(macro,{
                    action = "spawn",
                    towerIndex = idx,
                    unitUUID = tostring(args[1]),
                    time = tick() - startTime,
                    pos = {
                        x = args[2].X,
                        y = args[2].Y,
                        z = args[2].Z
                    }
                })

                setStatus("Spawn #"..idx, Color3.fromRGB(0,255,120))
            end
            return result
        end

        if tostring(self) == "UpgradeTower" and method == "InvokeServer" then
            local target = args[1]
            for i,v in pairs(placed) do
                if v == target then
                    table.insert(macro,{
                        action = "upgrade",
                        towerIndex = i,
                        time = tick() - startTime
                    })
                    setStatus("Upgrade #"..i, Color3.fromRGB(255,200,0))
                    break
                end
            end
        end
    end

    return old(self,...)
end)

recordBtn.MouseButton1Click:Connect(function()
    recording = true
    macro = {}
    placed = {}
    startTime = tick()
    setStatus("Recording...", Color3.fromRGB(255,80,80))
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    setStatus("Stopped: "..#macro.." steps", Color3.fromRGB(255,200,0))
end)

saveBtn.MouseButton1Click:Connect(function()
    writefile("macro.json", HttpService:JSONEncode(macro))
    setStatus("Saved macro.json", Color3.fromRGB(0,255,120))
end)

loadBtn.MouseButton1Click:Connect(function()
    if isfile("macro.json") then
        macro = HttpService:JSONDecode(readfile("macro.json"))
        setStatus("Loaded "..#macro.." steps", Color3.fromRGB(100,150,255))
    else
        setStatus("macro.json not found", Color3.fromRGB(255,80,80))
    end
end)

playBtn.MouseButton1Click:Connect(function()
    if playing or #macro == 0 then return end

    playing = true
    setStatus("Playing...", Color3.fromRGB(100,150,255))

    task.spawn(function()
        local created = {}
        local beginTime = tick()
        local errors = 0

        for i,step in ipairs(macro) do
            if not playing then break end

            local exactTime = beginTime + (step.time / playbackSpeed)
            repeat task.wait() until tick() >= exactTime

            if step.action == "spawn" then
                local ok,res = pcall(function()
                    return SpawnTower:InvokeServer(
                        step.unitUUID,
                        CFrame.new(step.pos.x, step.pos.y, step.pos.z)
                    )
                end)

                if ok and res then
                    created[step.towerIndex] = res

                    local t = tick()
                    while tick() - t < 0.18 do
                        task.wait()
                    end
                else
                    errors += 1
                end

            elseif step.action == "upgrade" then
                local tower = created[step.towerIndex]

                if tower then
                    local tries = 0
                    while tries < 15 and (not tower or not tower.Parent) do
                        tries += 1
                        task.wait(0.05)
                    end

                    local ok = pcall(function()
                        UpgradeTower:InvokeServer(tower)
                    end)

                    if not ok then
                        errors += 1
                        task.wait(0.25)

                        pcall(function()
                            UpgradeTower:InvokeServer(tower)
                        end)
                    end
                else
                    errors += 1
                end
            end
        end

        playing = false

        if errors == 0 then
            setStatus("Done", Color3.fromRGB(0,255,120))
        else
            setStatus("Done with "..errors.." errors", Color3.fromRGB(255,180,0))
        end
    end)
end)
