local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local VIM = game:GetService("VirtualInputManager")

-- // ПОИСК REMOTES
local SpawnTower, UpgradeTower, SkipWave, AutoSkip
local function findRemotes()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SpawnNewTower" then SpawnTower = v
        elseif v.Name == "UpgradeTower" then UpgradeTower = v
        elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then SkipWave = v
        elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then AutoSkip = v
        end
    end
end
findRemotes()

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false
local SETTINGS_FILE = "macro_v27_final_fix.json"

local function saveAll()
    writefile(SETTINGS_FILE, HttpService:JSONEncode({autoReplay=autoReplay, autoPlay=autoPlay, currentSlot=currentSlot, macros=allMacros}))
end

local function loadAll()
    if isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok then autoReplay=data.autoReplay; autoPlay=data.autoPlay; currentSlot=data.currentSlot or 1; allMacros=data.macros or {{},{},{}} end
    end
end
loadAll()

