local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local SETTINGS_FILE = "macro_v29_13.json"

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false

-- // ФУНКЦИИ ПАМЯТИ
local function saveAll()
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay, autoPlay = autoPlay,
            currentSlot = currentSlot, macros = allMacros
        }))
    end)
end

if isfile(SETTINGS_FILE) then
    pcall(function()
        local d = HttpService:JSONDecode(readfile(SETTINGS_FILE))
        allMacros = d.macros or {{},{},{}}
        autoReplay = d.autoReplay or false
        autoPlay = d.autoPlay or false
        currentSlot = d.currentSlot or 1
    end)
end

-- // ИНТЕРФЕЙС (FIXED & VERSIONED)
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "Macro_Final_V29_13"
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 340)
frame.Position = UDim2.new(0, 20, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 20)
title.Text = "ULTRA STABLE v29.13"
title.TextColor3 = Color3.fromRGB(0, 255, 120)
title.BackgroundTransparency = 1
title.Font = Enum.Font.SourceSansBold

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.Text = "READY"
status.BackgroundTransparency = 1

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(35, 35, 35)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 25)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function() if not recording then currentSlot = i updateUI() end end)
end

local function btn(txt, y, col)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,35)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = col or Color3.fromRGB(45,45,45)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    Instance.new("UICorner", b)
    return b
end

local recB = btn("RECORD", 60, Color3.fromRGB(130,0,0))
local playB = btn("PLAY", 105, Color3.fromRGB(0,110,0))
local arB = btn("Auto Replay: OFF", 150)
local apB = btn("Auto Play: OFF", 195)
local clB = btn("CLEAR SLOT", 240)

-- // ЯДРО (БЕЗ ЛАГОВ)
local oldNC; oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    if recording and not checkcaller() and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
        local n = self.Name:lower()
        if not n:find("move") and not n:find("heartbeat") then
            table.insert(allMacros[currentSlot], {name = self.Name, args = {...}, t = os.clock() - startTime})
        end
    end
    return oldNC(self, ...)
end)

recB.MouseButton1Click:Connect(function()
    recording = not recording
    if recording then 
        allMacros[currentSlot] = {} 
        startTime = os.clock() 
        status.Text = "RECORDING..."
    else 
        saveAll() 
        status.Text = "SAVED" 
        updateUI()
    end
end)

playB.MouseButton1Click:Connect(function()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local s = os.clock()
        for _, v in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock()-s) < v.t do task.wait() end
            local r = game:FindFirstChild(v.name, true)
            if r then if r:IsA("RemoteEvent") then r:FireServer(unpack(v.args)) else r:InvokeServer(unpack(v.args)) end end
        end
        playing = false status.Text = "READY"
    end)
end)

-- // ТВОЙ REPLAY (FIXED)
task.spawn(function()
    while task.wait(1) do
        local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true) or lp.PlayerGui:FindFirstChild("Retry", true)
        if rb and rb.Visible and autoReplay and not playing and not recording then
            pcall(function()
                for _, c in ipairs(getconnections(rb.MouseButton1Click)) do c:Fire() end
                for _, c in ipairs(getconnections(rb.Activated)) do c:Fire() end
            end)
        end
    end
end)

arB.MouseButton1Click:Connect(function() autoReplay = not autoReplay arB.Text = "Auto Replay: "..(autoReplay and "ON" or "OFF") saveAll() end)
apB.MouseButton1Click:Connect(function() autoPlay = not autoPlay apB.Text = "Auto Play: "..(autoPlay and "ON" or "OFF") saveAll() end)
clB.MouseButton1Click:Connect(function() allMacros[currentSlot] = {} updateUI() saveAll() end)

updateUI()
