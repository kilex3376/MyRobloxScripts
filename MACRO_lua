-- Логика воспроизведения
local function startPlay()
    if playing or #macro == 0 then return end
    playing = true
    status.Text = "Playing S" .. currentSlot
    task.spawn(function()
        local built = {}
        local begin = os.clock()
        for _, step in ipairs(macro) do
            if not playing then break end
            while os.clock() < begin + step.t do RunService.Heartbeat:Wait() end
            if step.action == "spawn" then
                local ok, tower = pcall(function() return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z)) end)
                if ok and tower then built[step.index] = tower end
            elseif step.action == "upgrade" and built[step.index] then
                pcall(function() UpgradeTower:InvokeServer(built[step.index]) end)
            elseif step.action == "delete" and built[step.index] then
                pcall(function()
                     for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                        if remote.Name == "SellTower" or remote.Name == "DeleteTower" then
                            remote:InvokeServer(built[step.index])
                            break
                        end
                    end
                    built[step.index] = nil
                end)
            end
        end
        playing = false
        status.Text = "Macro Finished"
        
        if autoReplay then
            setReplayFlag(currentSlot)
            task.wait(5)
            -- Функция вызывается из оригинального скрипта
            local success = pcall(function() return waitAndClickPlayAgain(30) end)
            if not success then
                TeleportService:Teleport(game.PlaceId, Players.LocalPlayer)
            end
        end
    end)
end

