local setPanel = createPanel("Settings", UDim2.new(0, 205, 0.5, -120), UDim2.new(0, 185, 0, 155))

local function addTitle(p, txt)
    local t = Instance.new("TextLabel", p)
    t.Size = UDim2.new(1, 0, 0, 25)
    t.BackgroundTransparency = 1
    t.Text, t.TextColor3 = txt, Color3.new(1, 1, 1)
