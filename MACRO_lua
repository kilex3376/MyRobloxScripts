local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TeleportService = game:GetService("TeleportService")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipRemote, AutoSkipRemote

-- ОБНОВЛЕННЫЙ ПОИСК (с учетом твоего кода)
for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
    local n = v.Name
    if n == "SpawnNewTower" or n == "PlaceTower" then SpawnTower = v
    elseif n == "UpgradeTower" then UpgradeTower = v
    elseif n == "SkipWave" or n == "VoteSkip" or n == "Skip" then SkipRemote = v 
    elseif n == "AutoSkip" or n == "ToggleAutoSkip" then AutoSkipRemote = v end
end

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

local SETTINGS_FILE = "macro_settings_v13.json"

local function saveSettings()
    if writefile then
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay,
            autoPlay = autoPlay,
            slot = currentSlot
        }))
    end
end

local function loadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then
            autoReplay = data.autoReplay or false
            autoPlay = data.autoPlay or false
            currentSlot = data.slot or 1
        end
    end
end

local function forceClick(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 1)
    end)
end

-- GUI (БЕЗ ИЗМЕНЕНИЙ СТИЛЯ)
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_V13_SkipFixed"
ui.ResetOnSpawn = false

local main = Instance.new("Frame", ui)
main.Size = UDim2.new(0, 150, 0, 235)
main.Position = UDim2.new(0, 20, 0.5, -115)
main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
main.Active, main.Draggable = true, true
Instance.new("UICorner", main)

local function btn(txt, y, h, color)
    local b = Instance.new("TextButton", main)
    b.Size, b.Position = UDim2.new(1, -14, 0, h), UDim2.new(0, 7, 0, y)
    b.Text, b.BackgroundColor3 = txt, color or Color3.fromRGB(45, 45, 45)
    b.TextColor3, b.Font, b.TextSize = Color3.new(1,1,1), Enum.Font.GothamBold, 10
    Instance.new("UICorner", b)
    return b
end

local slotBtn = btn("SLOT: "..currentSlot, 10, 25)
local recBtn = btn("START RECORD", 40, 35, Color3.fromRGB(80, 35, 35))
local playBtn = btn("PLAY MACRO", 80, 35, Color3.fromRGB(35, 80, 35))
local arBtn = btn("REPLAY: OFF", 120, 28)
local apBtn = btn("AUTO: OFF", 153, 28)
local delBtn = btn("DELETE DATA", 190, 25, Color3.fromRGB(100, 20, 20))

local function updateUI()
    slotBtn.Text = "SLOT: "..currentSlot.." ("..#allMacros[currentSlot]..")"
    arBtn.Text = "REPLAY: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    apBtn.Text = "AUTO PLAY: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30, 130, 30) or Color3.fromRGB(45, 45, 45)
    recBtn.Text = recording and "STOP & SAVE" or "START RECORD"
    recBtn.BackgroundColor3 = recording and Color3.fromRGB(150, 30, 30) or Color3.fromRGB(80, 35, 35)
end

-- ЛОГИКА КНОПОК
slotBtn.MouseButton1Click:Connect(function()
    if not recording then currentSlot = (currentSlot % SLOTS) + 1 saveSettings() updateUI() end
end)

recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    else
        recording = false
        if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    end
    updateUI()
end)

delBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    if isfile and isfile("macro_s"..currentSlot..".json") then delfile("macro_s"..currentSlot..".json") end
    updateUI()
end)

arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveSettings() updateUI() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveSettings() updateUI() end)

-- ЗАПИСЬ
RunService.Heartbeat:Connect(function()
    if recording then
        local replay = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
        if replay and replay.Visible then
            local c; c = replay.MouseButton1Click:Connect(function()
                if recording then
                    table.insert(allMacros[currentSlot], {action="rejoin", t=os.clock()-startTime})
                    recording = false
                    if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
                    updateUI()
                end
                c:Disconnect()
            end)
        end
    end
end)

-- ХУКИ
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if recording and not checkcaller() then
        if self == SpawnTower then
            local res = old(self, ...)
            table.insert(allMacros[currentSlot], {action="spawn", id=args[1], x=args[2].X, y=args[2].Y, z=args[2].Z, index=#placed+1, t=os.clock()-startTime})
            table.insert(placed, res or "dummy")
            return res
        elseif self == UpgradeTower then
            for i, v in pairs(placed) do
                if v == args[1] then table.insert(allMacros[currentSlot], {action="upgrade", index=i, t=os.clock()-startTime}) break end
            end
        elseif self == SkipRemote or self == AutoSkipRemote then
            table.insert(allMacros[currentSlot], {action="skip", t=os.clock()-startTime})
        end
    end
    return old(self, ...)
end)

-- PLAY
local function doPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    task.spawn(function()
        local currentPlaced = {}
        local playStartTime = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while os.clock() < playStartTime + step.t do RunService.Heartbeat:Wait() end
            pcall(function()
                if step.action == "spawn" then
                    local ok, obj = SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                    currentPlaced[step.index] = obj
                elseif step.action == "upgrade" and currentPlaced[step.index] then
                    UpgradeTower:InvokeServer(currentPlaced[step.index])
                elseif step.action == "skip" then
                    -- Пробуем оба варианта скипа
                    if SkipRemote then if SkipRemote:IsA("RemoteEvent") then SkipRemote:FireServer() else SkipRemote:InvokeServer() end end
                    if AutoSkipRemote then if AutoSkipRemote:IsA("RemoteEvent") then AutoSkipRemote:FireServer() else AutoSkipRemote:InvokeServer() end end
                elseif step.action == "rejoin" then
                    local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true)
                    forceClick(rb)
                end
            end)
        end
        playing = false
    end)
end

playBtn.MouseButton1Click:Connect(doPlay)
loadSettings()
for i=1, SLOTS do pcall(function() if isfile and isfile("macro_s"..i..".json") then allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json")) end end) end
updateUI()
if autoPlay then task.delay(6, doPlay) end
