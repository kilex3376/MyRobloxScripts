local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local SpawnTower
local UpgradeTower
local SkipWave
local AutoSkip

task.spawn(function()
    while not SpawnTower or not UpgradeTower do
        for _,v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v.Name == "SpawnNewTower" then
                SpawnTower = v
            elseif v.Name == "UpgradeTower" then
                UpgradeTower = v
            elseif v.Name == "SkipWave" or v.Name == "VoteSkip" then
                SkipWave = v
            elseif v.Name == "AutoSkip" or v.Name == "ToggleAutoSkip" then
                AutoSkip = v
            end
        end

        task.wait(1)
    end
end)

local recording = false
local playing = false
local macro = {}
local placed = {}
local startTime = 0
local lastSpawnTime = 0
local lastSpawnPos

local gui = Instance.new("ScreenGui")
gui.Name = "MacroGUI"
gui.ResetOnSpawn = false

pcall(function()
    if syn and syn.protect_gui then
        syn.protect_gui(gui)
    end
end)

gui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0, 190, 0, 150)
frame.Position = UDim2.new(0, 20, 0.5, -75)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,10)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,25)
title.BackgroundTransparency = 1
title.Text = "Macro"
title.TextColor3 = Color3.new(1,1,1)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 20

local function makeButton(text, y)
    local b = Instance.new("TextButton")
    b.Parent = frame
    b.Size = UDim2.new(0,170,0,30)
    b.Position = UDim2.new(0,10,0,y)
    b.BackgroundColor3 = Color3.fromRGB(40,40,40)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 18
    b.Text = text

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,8)
    c.Parent = b

    return b
end

local recordButton = makeButton("Record", 35)
local stopButton = makeButton("Stop", 70)
local playButton = makeButton("Play", 105)

local status = Instance.new("TextLabel")
status.Parent = frame
status.Size = UDim2.new(1,0,0,20)
status.Position = UDim2.new(0,0,1,0)
status.BackgroundTransparency = 1
status.Text = "Loading"
status.TextColor3 = Color3.new(1,1,1)
status.Font = Enum.Font.SourceSans
status.TextSize = 18

while not SpawnTower or not UpgradeTower do
    status.Text = "Waiting for match..."
    task.wait(1)
end

status.Text = "Ready"

if not hookmetamethod or not getnamecallmethod or not checkcaller then
    status.Text = "Executor unsupported"
    return
end

local old
old = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()

    if not checkcaller() and recording then
        if self == SpawnTower and method == "InvokeServer" then
            local cf = args[2]
            if typeof(cf) == "CFrame" then
                local pos = cf.Position

                if tick() - lastSpawnTime > 0.35 or not lastSpawnPos or (lastSpawnPos - pos).Magnitude > 1 then
                    lastSpawnTime = tick()
                    lastSpawnPos = pos

                    local result = old(self, ...)

                    local index = #placed + 1
                    placed[index] = result

                    table.insert(macro, {
                        action = "spawn",
                        index = index,
                        id = tostring(args[1]),
                        x = pos.X,
                        y = pos.Y,
                        z = pos.Z,
                        t = os.clock() - startTime
                    })

                    status.Text = "Spawn " .. index
                    return result
                end
            end
        elseif self == UpgradeTower and method == "InvokeServer" then
            local tower = args[1]

            for i = #placed, 1, -1 do
                if placed[i] == tower then
                    table.insert(macro, {
                        action = "upgrade",
                        index = i,
                        t = os.clock() - startTime
                    })

                    status.Text = "Upgrade " .. i
                    break
                end
            end
        elseif SkipWave and self == SkipWave and (method == "InvokeServer" or method == "FireServer") then
            table.insert(macro, {
                action = "skip",
                t = os.clock() - startTime
            })

            status.Text = "Skip"
        elseif AutoSkip and self == AutoSkip and (method == "InvokeServer" or method == "FireServer") then
            table.insert(macro, {
                action = "autoskip",
                value = args[1],
                t = os.clock() - startTime
            })

            status.Text = "AutoSkip"
        end
    end

    return old(self, ...)
end)

recordButton.MouseButton1Click:Connect(function()
    macro = {}
    placed = {}
    lastSpawnTime = 0
    lastSpawnPos = nil
    startTime = os.clock()
    recording = true
    status.Text = "Recording"
end)

stopButton.MouseButton1Click:Connect(function()
    recording = false
    if writefile then
        writefile("macro.json", HttpService:JSONEncode(macro))
    end
    status.Text = "Saved " .. #macro
end)

playButton.MouseButton1Click:Connect(function()
    if playing then return end

    if readfile and isfile and isfile("macro.json") then
        macro = HttpService:JSONDecode(readfile("macro.json"))
    end

    playing = true
    status.Text = "Playing"

    task.spawn(function()
        local built = {}
        local begin = os.clock()

        for _, step in ipairs(macro) do
            while os.clock() < begin + step.t do
                RunService.Heartbeat:Wait()
            end

            if step.action == "spawn" then
                local ok, tower = pcall(function()
                    return SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                end)

                if ok then
                    built[step.index] = tower
                end

                task.wait(0.05)
            elseif step.action == "upgrade" then
                if built[step.index] then
                    pcall(function()
                        UpgradeTower:InvokeServer(built[step.index])
                    end)
                end

                task.wait(0.1)
            elseif step.action == "skip" then
                pcall(function()
                    if SkipWave then
                        if SkipWave:IsA("RemoteFunction") then
                            SkipWave:InvokeServer()
                        else
                            SkipWave:FireServer()
                        end
                    end
                end)

            elseif step.action == "autoskip" then
                pcall(function()
                    if AutoSkip then
                        if AutoSkip:IsA("RemoteFunction") then
                            AutoSkip:InvokeServer(step.value)
                        else
                            AutoSkip:FireServer(step.value)
                        end
                    end
                end)
            end
        end

        playing = false
        status.Text = "Done"
    end)
end)
