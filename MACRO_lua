local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local SETTINGS_FILE = "macro_v29_15.json"

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}} 
local recording, playing = false, false
local startTime = 0
local autoReplay, autoPlay = false, false

-- // СОХРАНЕНИЕ
local function saveAll()
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay,
            autoPlay = autoPlay,
            currentSlot = currentSlot,
            macros = allMacros
        }))
    end)
end

-- // ЗАГРУЗКА
if isfile(SETTINGS_FILE) then
    pcall(function()
        local decoded = HttpService:JSONDecode(readfile(SETTINGS_FILE))
        allMacros = decoded.macros or {{},{},{}}
        autoReplay = decoded.autoReplay or false
        autoPlay = decoded.autoPlay or false
        currentSlot = decoded.currentSlot or 1
    end)
end

-- // ГУИ (v29.15 - NO LAGS)
local gui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
gui.Name = "Macro_V29_15"
local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 190, 0, 340)
frame.Position = UDim2.new(0, 20, 0.5, -170)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.Active, frame.Draggable = true, true
Instance.new("UICorner", frame)

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 20)
title.Text = "VERSION v29.15"
title.TextColor3 = Color3.fromRGB(0, 255, 150)
title.BackgroundTransparency = 1
title.Font = Enum.Font.SourceSansBold

local status = Instance.new("TextLabel", frame)
status.Size = UDim2.new(1,0,0,25)
status.Position = UDim2.new(0,0,1,-25)
status.TextColor3 = Color3.new(1,1,1)
status.Text = "READY"
status.BackgroundTransparency = 1

local slotBtns = {}
local function updateUI()
    for i = 1, SLOTS do
        if slotBtns[i] then
            slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(40, 40, 40)
            slotBtns[i].Text = "S" .. i .. " (" .. #allMacros[i] .. ")"
        end
    end
end

for i = 1, SLOTS do
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0, 54, 0, 25)
    b.Position = UDim2.new(0, 8 + (i-1)*60, 0, 25)
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = "S"..i
    Instance.new("UICorner", b)
    slotBtns[i] = b
    b.MouseButton1Click:Connect(function() 
        if not recording and not playing then currentSlot = i updateUI() saveAll() end 
    end)
end

local function makeBtn(txt, y, color)
    local b = Instance.new("TextButton", frame)
    b.Size = UDim2.new(0,174,0,32)
    b.Position = UDim2.new(0,8,0,y)
    b.BackgroundColor3 = color or Color3.fromRGB(50,50,50)
    b.TextColor3 = Color3.new(1,1,1)
    b.Text = txt
    Instance.new("UICorner", b)
    return b
end

local recBtn = makeBtn("RECORD", 60, Color3.fromRGB(150,0,0))
local playBtn = makeBtn("PLAY", 100, Color3.fromRGB(0,150,0))
local arBtn = makeBtn("Auto Replay: OFF", 140)
local apBtn = makeBtn("Auto Play: OFF", 180)
local delBtn = makeBtn("CLEAR SLOT", 220)

-- // ХУК ЗАПИСИ (С ФИЛЬТРОМ ЛАГОВ)
local lastUIUpdate = 0
local oldNC; oldNC = hookmetamethod(game, "__namecall", function(self, ...)
    if recording and not checkcaller() then
        if self:IsA("RemoteFunction") or self:IsA("RemoteEvent") then
            local n = self.Name:lower()
            -- Игнорим мусор
            if not n:find("move") and n ~= "saymessagerequest" and not n:find("heartbeat") then
                table.insert(allMacros[currentSlot], {
                    name = self.Name,
                    args = {...},
                    t = os.clock() - startTime
                })
                -- Оптимизация: обновляем UI редко
                if os.clock() - lastUIUpdate > 0.5 then
                    lastUIUpdate = os.clock()
                    task.spawn(updateUI)
                end
            end
        end
    end
    return oldNC(self, ...)
end)

-- // ПЛЕЕР
playBtn.MouseButton1Click:Connect(function()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    status.Text = "PLAYING..."
    task.spawn(function()
        local start = os.clock()
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            while (os.clock() - start) < step.t do task.wait() end
            pcall(function()
                local remote = game:FindFirstChild(step.name, true)
                if remote then
                    if remote:IsA("RemoteFunction") then remote:InvokeServer(unpack(step.args))
                    else remote:FireServer(unpack(step.args)) end
                end
            end)
        end
        playing = false
        status.Text = "READY"
    end)
end)

-- // КЛИКИ И ТУГЛЫ
recBtn.MouseButton1Click:Connect(function()
    if not recording then
        allMacros[currentSlot] = {}
        startTime = os.clock()
        recording = true
        status.Text = "RECORDING..."
    else
        recording = false
        saveAll()
        status.Text = "SAVED"
    end
    updateUI()
end)

local function sync()
    arBtn.Text = "Auto Replay: " .. (autoReplay and "ON" or "OFF")
    apBtn.Text = "Auto Play: " .. (autoPlay and "ON" or "OFF")
end

arBtn.MouseButton1Click:Connect(function() autoReplay = not autoReplay saveAll() sync() end)
apBtn.MouseButton1Click:Connect(function() autoPlay = not autoPlay saveAll() sync() end)
delBtn.MouseButton1Click:Connect(function() allMacros[currentSlot] = {} saveAll() updateUI() end)

-- // АВТОРЕПЛЕЙ (ОПТИМИЗИРОВАННЫЙ)
task.spawn(function()
    while task.wait(1.5) do
        if autoReplay and not playing and not recording then
            local rb = lp.PlayerGui:FindFirstChild("Play Again", true) or lp.PlayerGui:FindFirstChild("Replay", true) or lp.PlayerGui:FindFirstChild("Retry", true)
            if rb and rb.Visible then
                pcall(function()
                    for _, c in ipairs(getconnections(rb.MouseButton1Click)) do c:Fire() end
                    for _, c in ipairs(getconnections(rb.Activated)) do c:Fire() end
                end)
            end
        end
    end
end)

updateUI()
sync()
