local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TeleportService = game:GetService("TeleportService")

local lp = Players.LocalPlayer
local SpawnTower, UpgradeTower, SkipRemote

-- Поиск ресурсов игры
local function findAssets()
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SpawnNewTower" or v.Name == "PlaceTower" then SpawnTower = v
        elseif v.Name == "UpgradeTower" then UpgradeTower = v
        elseif v.Name == "SkipWave" or v.Name == "VoteSkip" or v.Name == "Skip" then SkipRemote = v end
    end
end
findAssets()

local SLOTS = 3
local currentSlot = 1
local allMacros = {{}, {}, {}}
local recording, playing = false, false
local placed = {} 
local startTime = 0
local autoReplay, autoPlay = false, false

local SETTINGS_FILE = "macro_settings_v5.json"
local FLAG_FILE = "macro_rejoin_flag.json"

-- Сохранение настроек (чтобы не выключались)
local function saveSettings()
    if writefile then
        writefile(SETTINGS_FILE, HttpService:JSONEncode({
            autoReplay = autoReplay,
            autoPlay = autoPlay,
            currentSlot = currentSlot
        }))
    end
end

-- Загрузка настроек
local function loadSettings()
    if isfile and isfile(SETTINGS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
        if ok and data then
            autoReplay = data.autoReplay or false
            autoPlay = data.autoPlay or false
            currentSlot = data.currentSlot or 1
        end
    end
end

local function forceClick(btn)
    if not btn then return end
    pcall(function()
        btn:Activate()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 1)
        task.wait(0.1)
        VirtualInputManager:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 1)
    end)
end

--================ GUI ================--
local ui = Instance.new("ScreenGui", lp.PlayerGui)
ui.Name = "Macro_Fixed_V6"
ui.ResetOnSpawn = false

local function createPanel(name, pos, size)
    local f = Instance.new("Frame", ui)
    f.Name = name
    f.Size, f.Position = size, pos
    f.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    f.BorderSizePixel = 0
    f.Active, f.Draggable = true, true
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
    return f
end

local mainPanel = createPanel("Main", UDim2.new(0, 20, 0.5, -135), UDim2.new(0, 200, 0, 240))
local setPanel = createPanel("Settings", UDim2.new(0, 230, 0.5, -135), UDim2.new(0, 200, 0, 210))

local function btn(p, txt, pos, size, color)
    local b = Instance.new("TextButton", p)
    b.Size, b.Position, b.Text = size, pos, txt
    b.BackgroundColor3 = color or Color3.fromRGB(45, 45, 45)
    b.TextColor3, b.Font, b.TextSize = Color3.new(1,1,1), Enum.Font.GothamBold, 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local statusLbl = Instance.new("TextLabel", mainPanel)
statusLbl.Size, statusLbl.Position = UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 1, -25)
statusLbl.BackgroundTransparency, statusLbl.TextColor3 = 1, Color3.new(1,1,1)

local slotBtns = {}
for i = 1, SLOTS do
    slotBtns[i] = btn(mainPanel, "S"..i, UDim2.new(0, 10 + (i-1)*62, 0, 40), UDim2.new(0, 58, 0, 35))
end

local recBtn = btn(mainPanel, "START RECORD", UDim2.new(0, 10, 0, 85), UDim2.new(1, -20, 0, 40), Color3.fromRGB(70, 30, 30))
local playBtn = btn(mainPanel, "PLAY MACRO", UDim2.new(0, 10, 0, 130), UDim2.new(1, -20, 0, 40), Color3.fromRGB(30, 70, 30))
local stopBtn = btn(mainPanel, "STOP / SAVE", UDim2.new(0, 10, 0, 175), UDim2.new(1, -20, 0, 35))

local arBtn = btn(setPanel, "Auto-Replay: OFF", UDim2.new(0, 10, 0, 45), UDim2.new(1, -20, 0, 40))
local apBtn = btn(setPanel, "Auto-Play: OFF", UDim2.new(0, 10, 0, 90), UDim2.new(1, -20, 0, 40))
local clearBtn = btn(setPanel, "DELETE DATA", UDim2.new(0, 10, 0, 140), UDim2.new(1, -20, 0, 30), Color3.fromRGB(100, 30, 30))

local function updateUI()
    for i = 1, SLOTS do
        slotBtns[i].BackgroundColor3 = (i == currentSlot) and Color3.fromRGB(80, 70, 200) or Color3.fromRGB(45, 45, 45)
    end
    arBtn.Text = "Auto-Replay: " .. (autoReplay and "ON" or "OFF")
    arBtn.BackgroundColor3 = autoReplay and Color3.fromRGB(30, 140, 30) or Color3.fromRGB(45, 45, 45)
    apBtn.Text = "Auto-Play: " .. (autoPlay and "ON" or "OFF")
    apBtn.BackgroundColor3 = autoPlay and Color3.fromRGB(30, 140, 30) or Color3.fromRGB(45, 45, 45)
    statusLbl.Text = playing and "PLAYING..." or (recording and "RECORDING..." or "Slot "..currentSlot)
end

--================ ЛОГИКА PLAY ================--
local function startPlay()
    if playing or #allMacros[currentSlot] == 0 then return end
    playing = true
    updateUI()
    
    task.spawn(function()
        local built = {}
        -- Если включили в середине игры, считаем время от начала раунда (00:00 на таймере)
        local gameTimeOffset = 0 
        pcall(function()
            local timerStr = lp.PlayerGui.GameGui.Main.Top.Timer.Text -- Путь может отличаться
            local m, s = timerStr:match("(%d+):(%d+)")
            gameTimeOffset = tonumber(m)*60 + tonumber(s)
        end)

        local startT = os.clock() - gameTimeOffset
        
        for _, step in ipairs(allMacros[currentSlot]) do
            if not playing then break end
            if step.t < gameTimeOffset then continue end -- Пропускаем старые действия
            
            while os.clock() < startT + step.t do RunService.Heartbeat:Wait() end
            
            pcall(function()
                if step.action == "spawn" then
                    local ok, t = SpawnTower:InvokeServer(step.id, CFrame.new(step.x, step.y, step.z))
                    if ok and t then built[step.index] = t end
                elseif step.action == "upgrade" and built[step.index] then
                    UpgradeTower:InvokeServer(built[step.index])
                elseif step.action == "skip" then
                    if SkipRemote then SkipRemote:InvokeServer() end
                end
            end)
        end
        
        -- Реплей
        while playing do
            local replayBtn = lp.PlayerGui:FindFirstChild("EndScreen", true)
            if replayBtn and replayBtn.Visible then
                if autoReplay then
                    task.wait(2)
                    forceClick(replayBtn)
                    task.wait(5)
                    TeleportService:Teleport(game.PlaceId, lp)
                end
                break
            end
            task.wait(2)
        end
        playing = false
        updateUI()
    end)
end

--================ ХУКИ ================--
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if recording and not checkcaller() then
        if self == SpawnTower and method == "InvokeServer" then
            local res = old(self, ...)
            if res then
                local idx = #placed + 1
                placed[idx] = res
                table.insert(allMacros[currentSlot], {action = "spawn", id = args[1], x = args[2].X, y = args[2].Y, z = args[2].Z, index = idx, t = os.clock() - startTime})
            end
            return res
        elseif self == UpgradeTower and method == "InvokeServer" then
            for i, v in pairs(placed) do
                if v == args[1] then
                    table.insert(allMacros[currentSlot], {action = "upgrade", index = i, t = os.clock() - startTime})
                    break
                end
            end
        elseif self == SkipRemote and method == "InvokeServer" then
            table.insert(allMacros[currentSlot], {action = "skip", t = os.clock() - startTime})
        end
    end
    return old(self, ...)
end)

--================ КНОПКИ ================--
for i = 1, SLOTS do
    slotBtns[i].MouseButton1Click:Connect(function()
        if not recording and not playing then currentSlot = i saveSettings() updateUI() end
    end)
end

recBtn.MouseButton1Click:Connect(function()
    if playing then return end
    allMacros[currentSlot], placed, startTime, recording = {}, {}, os.clock(), true
    updateUI()
end)

stopBtn.MouseButton1Click:Connect(function()
    recording = false
    if writefile then writefile("macro_s"..currentSlot..".json", HttpService:JSONEncode(allMacros[currentSlot])) end
    updateUI()
end)

playBtn.MouseButton1Click:Connect(startPlay)

arBtn.MouseButton1Click:Connect(function()
    autoReplay = not autoReplay
    saveSettings()
    updateUI()
end)

apBtn.MouseButton1Click:Connect(function()
    autoPlay = not autoPlay
    saveSettings()
    updateUI()
    if autoPlay then startPlay() end
end)

clearBtn.MouseButton1Click:Connect(function()
    allMacros[currentSlot] = {}
    updateUI()
end)

--================ СТАРТ ================--
loadSettings()
for i = 1, SLOTS do
    pcall(function()
        if isfile and isfile("macro_s"..i..".json") then
            allMacros[i] = HttpService:JSONDecode(readfile("macro_s"..i..".json"))
        end
    end)
end
updateUI()

task.spawn(function()
    task.wait(7)
    if autoPlay then startPlay() end
end)
